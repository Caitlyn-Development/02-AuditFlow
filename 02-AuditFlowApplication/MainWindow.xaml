<Window x:Class="_02_AuditFlowApplication.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_02_AuditFlowApplication"
        mc:Ignorable="d"
        Title="AuditFlow" Height="700" Width="1400"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#FFFFFF">

    <Window.Resources>
        <!-- Button Style -->
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F0F0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Card Style -->
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.1" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section Header Style -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,20,0,15"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Navigation Bar -->
        <Border Grid.Row="0" 
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1" Height="80">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo and Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Image x:Name="Logo" Source="/Resources/PNG/AuditFlow Logo.png" Width="177" Margin="220,0,0,0" Height="72"/>
                </StackPanel>

                <!-- Right Side Icons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="⚙" 
                            FontSize="20"
                            Width="40"
                            Height="40"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="5,0" Foreground="Black"/>
                    <Button Content="●" 
                            FontSize="20"
                            Width="40"
                            Height="40"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="5,0" Foreground="Black"/>
                    <Button x:Name="LogoutButton"
                            Content="↪" 
                            Click="LogoutButton_Click"
                            FontSize="20"
                            Width="40"
                            Height="40"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="5,0" Foreground="Black"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar Menu -->
            <Border Grid.Column="0" 
                    Background="White" 
                    BorderBrush="#E0E0E0"
                    BorderThickness="0,0,1,0"
                    Padding="15,20">
                <StackPanel>
                    <Button Content="Dashboard" 
                            Style="{StaticResource MenuButtonStyle}"
                            Background="#E3F2FD"
                            Foreground="#2196F3"
                            FontWeight="SemiBold"/>

                    <Button Content="Audits" 
                            Style="{StaticResource MenuButtonStyle}" Foreground="#FF1E1E1E" FontFamily="Verdana"/>

                    <Button Content="Tasks" 
                            Style="{StaticResource MenuButtonStyle}" Foreground="#FF1E1E1E" FontFamily="Verdana"/>

                    <Separator Margin="0,15" Background="#E0E0E0"/>
                </StackPanel>
            </Border>

            <!-- Main Dashboard Content -->
            <ScrollViewer Grid.Column="1" 
                          VerticalScrollBarVisibility="Auto"
                          Padding="30,20">
                <StackPanel>
                    <!-- Dashboard Header -->
                    <TextBlock Text="Dashboard" 
                               FontSize="22" 
                               Margin="0,0,-3,25"
                               Foreground="#FF1E1E1E" FontFamily="Verdana" FontWeight="Bold" Width="1101"/>

                    <!-- Statistics Cards Row -->
                    <Grid Margin="0,0,0,40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Name="TotalAudits" Width="*"/>
                            <ColumnDefinition Name="InProgressAudits" Width="*"/>
                            <ColumnDefinition Name="CompletedAudits" Width="*"/>
                            <ColumnDefinition Name="OverdueAudits" Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Total Audits Card -->
                        <Border Grid.Column="0" Style="{StaticResource StatCardStyle}" CornerRadius="15,15,15,15" BorderThickness="2,2,2,2" Margin="24,0,25,0" Padding="10,10,10,10" Height="110" VerticalAlignment="Center" Width="227">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="#FF1E1E1E" Opacity="0.2"/>
                            </Border.BorderBrush>
                            <StackPanel>
                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Name="CardTitle" Width="*"/>
                                        <ColumnDefinition Name="CardIcon" Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Total Audits" 
                                           FontSize="18" 
                                           Foreground="#FF1E1E1E" FontFamily="Verdana" Grid.ColumnSpan="2" HorizontalAlignment="Left" Width="139" Padding="0,5,0,5"/>
                                    <Border Grid.Column="1" Background="#E3F2FD"
        CornerRadius="4"
        Margin="70,0,0,0"
        VerticalAlignment="Top" Width="30" Height="30">
                                    </Border>
                                </Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="5" 
                                               FontSize="20" 
                                               FontWeight="Bold" 
                                               Foreground="#FF1E1E1E" FontFamily="Verdana"/>
                                </StackPanel>
                                <TextBlock Text="Total audits assigned to you" 
                                           FontSize="14" 
                                           Foreground="#FF1E1E1E"
                                           TextWrapping="Wrap" FontFamily="Verdana" Padding="0,5,0,5"/>
                            </StackPanel>
                        </Border>

                        <!-- Audits In Progress Card -->
                        <Border Style="{StaticResource StatCardStyle}" CornerRadius="15,15,15,15" BorderThickness="2,2,2,2" Padding="10,10,10,10" Margin="24,0,25,0" Height="110" VerticalAlignment="Center" Width="227" Grid.Column="1">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="#FF1E1E1E" Opacity="0.2"/>
                            </Border.BorderBrush>
                            <StackPanel>
                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Audits In Progress" 
                                           FontSize="18" 
                                           Foreground="#FF1E1E1E" FontFamily="Verdana" Grid.ColumnSpan="2" Padding="0,5,0,5" Margin="0,0,36,0"/>
                                    <Border Grid.Column="1" Background="#FFF3E0"
                                            CornerRadius="4"
        Margin="70,0,0,0"
        VerticalAlignment="Top" Width="30" Height="30">
                                    </Border>
                                </Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="3" 
                                               FontSize="20" 
                                               FontWeight="Bold" 
                                               Foreground="#FF1E1E1E" FontFamily="Verdana"/>
                                </StackPanel>
                                <TextBlock Text="Currently active audits" 
                                           FontSize="14" 
                                           Foreground="#FF1E1E1E"
                                           Margin="0,5,0,0"
                                           TextWrapping="Wrap" FontFamily="Verdana" Padding="0,5,0,5"/>
                            </StackPanel>
                        </Border>

                        <!-- Completed Audits Card -->
                        <Border Grid.Column="2" Style="{StaticResource StatCardStyle}" CornerRadius="15,15,15,15" BorderThickness="2,2,2,2" Padding="10,10,10,10" Margin="24,0,24,0" Height="110" VerticalAlignment="Center" Width="227">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="#FF1E1E1E" Opacity="0.2"/>
                            </Border.BorderBrush>
                            <StackPanel>
                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" 
                                           FontSize="18" 
                                           Foreground="#FF1E1E1E" 
                                           FontFamily="Verdana" 
                                           Padding="0,5,0,5"
                                           Text="Completed Audits" Grid.ColumnSpan="2" Margin="0,0,39,0"></TextBlock>
                                    <Border Grid.Column="1" Background="#E8F5E9"
        CornerRadius="4"
        Margin="70,0,0,0"
        VerticalAlignment="Top" Width="30" Height="30">
                                    </Border>

                                </Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="2" 
                                               FontSize="20" 
                                               FontWeight="Bold" 
                                               Foreground="#FF1E1E1E" FontFamily="Verdana"/>
                                </StackPanel>
                                <TextBlock Text="Closed audits" 
                                           FontSize="14" 
                                           Foreground="#FF1E1E1E"
                                           Margin="0,5,0,0"
                                           TextWrapping="Wrap" FontFamily="Verdana" Padding="0,5,0,5"/>
                            </StackPanel>
                        </Border>

                        <!-- Overdue Audits Card -->
                        <Border Grid.Column="3" Style="{StaticResource StatCardStyle}" CornerRadius="15,15,15,15" BorderThickness="2,2,2,2" Padding="10,10,10,10" Margin="25,0,24,0" Height="110" VerticalAlignment="Center" Width="227">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="#FF1E1E1E" Opacity="0.2"/>
                            </Border.BorderBrush>
                            <StackPanel>
                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Overdue Audits" 
                                           FontSize="18" 
                                           Foreground="#FF1E1E1E" FontFamily="Verdana" Padding="0,5,0,5" Grid.ColumnSpan="2" Margin="0,0,53,0"/>
                                    <Border Grid.Column="1" Background="#FFEBEE"
        CornerRadius="4"
        Margin="70,0,0,0"
        VerticalAlignment="Top" Width="30" Height="30"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="0" 
                                               FontSize="20" 
                                               FontWeight="Bold" 
                                               Foreground="#FF1E1E1E" FontFamily="Verdana"/>
                                </StackPanel>
                                <TextBlock Text="Audits past due date" 
                                           FontSize="14" 
                                           Foreground="#FF1E1E1E"
                                           Margin="0,5,0,0"
                                           TextWrapping="Wrap" FontFamily="Verdana" Padding="0,5,0,5"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Calendar Section -->
                    <Border Background="White" 
                            CornerRadius="10" 
                            Padding="25"
                            Margin="0,0,0,25" BorderThickness="2,2,2,2">
                        <Border.BorderBrush>
                            <SolidColorBrush Color="#FF1E1E1E" Opacity="0.2"/>
                        </Border.BorderBrush>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.1" Color="#000000"/>
                        </Border.Effect>

                        <StackPanel>
                            <!-- Calendar Header -->
                            <Grid Margin="0,0,0,20">
                                <TextBlock Text="Calendar" 
                                           FontSize="22" 
                                           FontWeight="SemiBold"
                                           Foreground="#FF1E1E1E"
                                           VerticalAlignment="Center" FontFamily="Verdana"/>

                                <StackPanel Orientation="Horizontal" 
                                            HorizontalAlignment="Right">
                                    <Button Content="◀" 
                                            x:Name="PrevMonthButton"
                                            Width="35"
                                            Height="35"
                                            Background="#F5F5F5"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Margin="0,0,10,0"/>
                                    <TextBlock x:Name="CalendarMonthYear"
                                               Text="October 2026" 
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Margin="10,0"/>
                                    <Button Content="▶" 
                                            x:Name="NextMonthButton"
                                            Width="35"
                                            Height="35"
                                            Background="#F5F5F5"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Margin="10,0,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Calendar Grid -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Day Headers -->
                                <UniformGrid Grid.Row="0" Rows="1" Columns="7" Margin="0,0,0,10">
                                    <TextBlock Text="Mon" HorizontalAlignment="Center" Foreground="#999999" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="Tue" HorizontalAlignment="Center" Foreground="#999999" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="Wed" HorizontalAlignment="Center" Foreground="#999999" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="Thur" HorizontalAlignment="Center" Foreground="#999999" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="Fri" HorizontalAlignment="Center" Foreground="#999999" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="Sat" HorizontalAlignment="Center" Foreground="#999999" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="Sun" HorizontalAlignment="Center" Foreground="#999999" FontSize="12" FontWeight="SemiBold"/>
                                </UniformGrid>

                                <!-- Calendar Days -->
                                <UniformGrid x:Name="CalendarGrid" 
                                             Grid.Row="1" 
                                             Rows="5" 
                                             Columns="7">
                                    <!-- Days will be populated programmatically -->
                                    <!-- Example structure for reference -->
                                    <Border Background="#F8F8F8" 
                                            Margin="2" 
                                            Height="80"
                                            BorderBrush="#E0E0E0"
                                            BorderThickness="1">
                                        <StackPanel Margin="8">
                                            <TextBlock Text="1" FontSize="14" Foreground="#666"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Upcoming Deadlines Section -->
                    <Border Background="White" 
                            CornerRadius="8" 
                            Padding="25" BorderThickness="2,2,2,2">
                        <Border.BorderBrush>
                            <SolidColorBrush Color="#FF1E1E1E" Opacity="0.2"/>
                        </Border.BorderBrush>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.1" Color="#000000"/>
                        </Border.Effect>

                        <StackPanel>
                            <TextBlock Text="Upcoming Deadlines" 
                                       Style="{StaticResource SectionHeaderStyle}"
                                       Margin="0,0,0,20" FontFamily="Verdana" Foreground="#FF1E1E1E" FontSize="22"/>

                            <!-- Deadlines Table -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Table Header -->
                                <Grid Grid.Row="0" 
                                      Background="#F8F9FA"
                                      Margin="0,0,0,10"
                                      Height="45">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" 
                                               Text="Audit Name" 
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="#666666"
                                               VerticalAlignment="Center"
                                               Margin="15,0"/>
                                    <TextBlock Grid.Column="1" 
                                               Text="Type of Audit" 
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="#666666"
                                               VerticalAlignment="Center"
                                               Margin="15,0"/>
                                    <TextBlock Grid.Column="2" 
                                               Text="Due Date" 
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="#666666"
                                               VerticalAlignment="Center"
                                               Margin="15,0"/>
                                    <TextBlock Grid.Column="3" 
                                               Text="Status" 
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="#666666"
                                               VerticalAlignment="Center"
                                               Margin="15,0"/>
                                </Grid>

                                <!-- Sample Row 1 -->
                                <Grid Grid.Row="1" 
                                      Height="60"
                                      Background="White">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" 
                                            Grid.ColumnSpan="4" 
                                            BorderBrush="#F0F0F0" 
                                            BorderThickness="0,0,0,1"/>

                                    <TextBlock Grid.Column="0" 
                                               Text="IT Systems Audit 2025" 
                                               FontSize="14"
                                               Foreground="#333333"
                                               VerticalAlignment="Center"
                                               Margin="15,0"/>
                                    <TextBlock Grid.Column="1" 
                                               Text="IT" 
                                               FontSize="14"
                                               Foreground="#666666"
                                               VerticalAlignment="Center"
                                               Margin="15,0"/>
                                    <TextBlock Grid.Column="2" 
                                               Text="22-10-2025" 
                                               FontSize="14"
                                               Foreground="#666666"
                                               VerticalAlignment="Center"
                                               Margin="15,0"/>
                                    <Border Grid.Column="3" 
                                            Background="#E3F2FD"
                                            CornerRadius="12"
                                            Padding="12,6"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Margin="15,0">
                                        <TextBlock Text="In Progress" 
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#2196F3"/>
                                    </Border>
                                </Grid>

                                <!-- Sample Row 2 -->
                                <Grid Grid.Row="2" 
                                      Height="60"
                                      Background="White">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" 
                                               Text="Supplier Risk Assessment" 
                                               FontSize="14"
                                               Foreground="#333333"
                                               VerticalAlignment="Center"
                                               Margin="15,0"/>
                                    <TextBlock Grid.Column="1" 
                                               Text="Procurement" 
                                               FontSize="14"
                                               Foreground="#666666"
                                               VerticalAlignment="Center"
                                               Margin="15,0"/>
                                    <TextBlock Grid.Column="2" 
                                               Text="13-10-2025" 
                                               FontSize="14"
                                               Foreground="#666666"
                                               VerticalAlignment="Center"
                                               Margin="15,0"/>
                                    <Border Grid.Column="3" 
                                            Background="#F5F5F5"
                                            CornerRadius="12"
                                            Padding="12,6"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Margin="15,0">
                                        <TextBlock Text="Not Started" 
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#666666"/>
                                    </Border>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
