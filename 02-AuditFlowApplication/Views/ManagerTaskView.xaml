<UserControl
    x:Class="_02_AuditFlowApplication.Views.ManagerTaskView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:_02_AuditFlowApplication"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
    xmlns:views="clr-namespace:_02_AuditFlowApplication.Views"
    Background="#FFFFFF"
    mc:Ignorable="d">

    <Grid VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <views:ManagerLayout
            x:Name="Layout"
            Grid.Row="0"
            Grid.RowSpan="2" />


        <ScrollViewer
            Grid.Row="1"
            Height="944"
            Margin="251,120,0,0"
            Padding="30,20"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Width="1589">
                <!--  Dashboard Header  -->
                <TextBlock
                    Width="1121"
                    Margin="10,0,0,25"
                    HorizontalAlignment="Left"
                    FontFamily="Verdana"
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="#FF1E1E1E"
                    Text="Tasks &amp; Evidence Management " />


                <!--  Statistics Cards Row  -->
                <Grid Width="1453" Margin="0,0,0,40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  Filter Button  -->
                    <Border
                        Grid.Column="0"
                        Width="100"
                        Height="80"
                        Margin="0,0,30,0"
                        Padding="10,10,10,10"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        BorderThickness="2,2,2,2"
                        CornerRadius="15,15,15,15"
                        Style="{StaticResource StatCardStyle}">
                        <Border.BorderBrush>
                            <SolidColorBrush Opacity="0.2" Color="#FF1E1E1E" />
                        </Border.BorderBrush>
                        <StackPanel>
                            <svgc:SvgViewbox
                                Width="40"
                                Height="40"
                                Margin="0,10,0,10"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Source="/Resources/Svg/filter-solid-full.svg" />
                            <StackPanel Orientation="Horizontal" />
                        </StackPanel>
                    </Border>

                    <!--  Search Audits  -->
                    <Border
                        Grid.Column="1"
                        Width="500"
                        Height="80"
                        Margin="0,0,50,0"
                        Padding="15,0,15,0"
                        VerticalAlignment="Center"
                        Background="White"
                        BorderThickness="2"
                        CornerRadius="15">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="8"
                                Opacity="0.1"
                                ShadowDepth="2"
                                Color="#000000" />
                        </Border.Effect>
                        <Border.BorderBrush>
                            <SolidColorBrush Opacity="0.2" Color="#FF1E1E1E" />
                        </Border.BorderBrush>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--  Search Icon  -->
                            <svgc:SvgViewbox
                                Grid.Column="0"
                                Width="30"
                                Height="30"
                                Margin="0,0,15,0"
                                VerticalAlignment="Center"
                                Source="/Resources/Svg/magnifying-glass-solid-full.svg" />

                            <!--  Search TextBox  -->
                            <TextBox
                                x:Name="SearchTextBox"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                FontFamily="Verdana"
                                FontSize="18"
                                Foreground="#1E1E1E"
                                GotFocus="SearchTextBox_GotFocus"
                                LostFocus="SearchTextBox_LostFocus"
                                TextChanged="SearchTextBox_TextChanged">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TextBox">
                                                    <Grid>
                                                        <!--  Placeholder Text  -->
                                                        <TextBlock
                                                            x:Name="PlaceholderText"
                                                            VerticalAlignment="Center"
                                                            FontFamily="Verdana"
                                                            FontSize="18"
                                                            Foreground="#999999"
                                                            IsHitTestVisible="False"
                                                            Text="Search Tasks">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                        <!--  Actual TextBox  -->
                                                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>

                            <!--  Search Suggestions Popup  -->
                            <Popup
                                x:Name="SearchPopup"
                                Grid.Column="1"
                                Width="470"
                                AllowsTransparency="True"
                                IsOpen="False"
                                Placement="Bottom"
                                PlacementTarget="{Binding ElementName=SearchTextBox}"
                                StaysOpen="False">
                                <Border
                                    MaxHeight="300"
                                    Margin="0,4,0,0"
                                    Background="White"
                                    BorderBrush="#E0E0E0"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <Border.Effect>
                                        <DropShadowEffect
                                            BlurRadius="10"
                                            Opacity="0.2"
                                            ShadowDepth="2"
                                            Color="#000000" />
                                    </Border.Effect>
                                    <ListBox
                                        x:Name="SearchResultsListBox"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                        SelectionChanged="SearchResultsListBox_SelectionChanged">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="15,12" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border
                                                                Padding="{TemplateBinding Padding}"
                                                                Background="{TemplateBinding Background}"
                                                                BorderThickness="0">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#F5F5F5" />
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter Property="Background" Value="#E3F2FD" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock
                                                        FontFamily="Verdana"
                                                        FontSize="16"
                                                        FontWeight="SemiBold"
                                                        Foreground="#1E1E1E"
                                                        Text="{Binding TaskName}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>

                    <!--  Audit Name Filter  -->
                    <ComboBox
                        x:Name="AuditFilterBox"
                        Grid.Column="2"
                        Width="225"
                        Height="80"
                        Margin="0,0,30,0"
                        Padding="20"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="White"
                        BorderThickness="2"
                        FontFamily="Verdana"
                        FontSize="18"
                        Foreground="#1e1e1e"
                        SelectionChanged="AuditFilterBox_Changed"
                        Style="{StaticResource DefaultComboBoxStyle}">
                        <ComboBox.Resources>
                            <Style x:Key="ArrowStyle" TargetType="Path">
                                <Setter Property="Fill" Value="#1e1e1e" />
                            </Style>
                        </ComboBox.Resources>
                        <ComboBox.BorderBrush>
                            <SolidColorBrush Opacity="0.2" Color="#FF883535" />
                        </ComboBox.BorderBrush>
                        <ComboBox.Items>
                            <ComboBoxItem
                                Content="All Audits"
                                IsSelected="True"
                                Style="{StaticResource DefaultComboBoxItemStyle}" />
                        </ComboBox.Items>
                    </ComboBox>

                    <!--  Status Filter  -->
                    <ComboBox
                        x:Name="StatusFilterBox"
                        Grid.Column="3"
                        Width="225"
                        Height="80"
                        Margin="0,0,30,0"
                        Padding="20"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="White"
                        BorderThickness="2"
                        FontFamily="Verdana"
                        FontSize="18"
                        Foreground="#1e1e1e"
                        SelectionChanged="StatusFilterBox_Changed"
                        Style="{StaticResource DefaultComboBoxStyle}">
                        <ComboBox.Resources>
                            <Style x:Key="ArrowStyle" TargetType="Path">
                                <Setter Property="Fill" Value="#1e1e1e" />
                            </Style>
                        </ComboBox.Resources>
                        <ComboBox.BorderBrush>
                            <SolidColorBrush Opacity="0.2" Color="#FF1E1E1E" />
                        </ComboBox.BorderBrush>
                        <ComboBox.Items>
                            <ComboBoxItem
                                Content="All Status"
                                IsSelected="True"
                                Style="{StaticResource DefaultComboBoxItemStyle}" />
                            <ComboBoxItem Content="Not Started" Style="{StaticResource DefaultComboBoxItemStyle}" />
                            <ComboBoxItem Content="In Progress" Style="{StaticResource DefaultComboBoxItemStyle}" />
                            <ComboBoxItem Content="On Hold" Style="{StaticResource DefaultComboBoxItemStyle}" />
                            <ComboBoxItem Content="Completed" Style="{StaticResource DefaultComboBoxItemStyle}" />
                            <ComboBoxItem Content="Overdue" Style="{StaticResource DefaultComboBoxItemStyle}" />
                        </ComboBox.Items>
                    </ComboBox>


                    <!--  Users Filter  -->
                    <ComboBox
                        x:Name="UsersFilterBox"
                        Grid.Column="4"
                        Width="225"
                        Height="80"
                        Margin="0,0,30,0"
                        Padding="20"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="White"
                        BorderThickness="2"
                        FontFamily="Verdana"
                        FontSize="18"
                        Foreground="#1e1e1e"
                        SelectionChanged="UsersFilterBox_Changed"
                        Style="{StaticResource DefaultComboBoxStyle}">
                        <ComboBox.Resources>
                            <Style x:Key="ArrowStyle" TargetType="Path">
                                <Setter Property="Fill" Value="#1e1e1e" />
                            </Style>
                        </ComboBox.Resources>
                        <ComboBox.BorderBrush>
                            <SolidColorBrush Opacity="0.2" Color="#FF1E1E1E" />
                        </ComboBox.BorderBrush>
                    </ComboBox>
                </Grid>

                <!--  Tasks Section  -->
                <Border
                    Width="1459"
                    MinHeight="437"
                    Margin="0,0,0,25"
                    Padding="25"
                    Background="White"
                    BorderThickness="2"
                    CornerRadius="15">
                    <Border.BorderBrush>
                        <SolidColorBrush Opacity="0.2" Color="#FF1E1E1E" />
                    </Border.BorderBrush>

                    <!--  Tasks Header  -->
                    <StackPanel>
                        <Grid Margin="0,0,0,20">
                            <TextBlock
                                Margin="0,0,1141,0"
                                VerticalAlignment="Center"
                                FontFamily="Verdana"
                                FontSize="22"
                                FontWeight="SemiBold"
                                Foreground="#FF1E1E1E"
                                Text="Assigned Tasks" />
                        </Grid>

                        <DataGrid
                            x:Name="TasksGrid"
                            Height="300"
                            AutoGenerateColumns="False"
                            Background="White"
                            BorderBrush="Black"
                            BorderThickness="0"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            GridLinesVisibility="None"
                            HeadersVisibility="Column"
                            IsReadOnly="True"
                            RowHeight="45"
                            SelectionMode="Single"
                            SelectionUnit="FullRow">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="#1e1e1e" />
                                    <Setter Property="FontFamily" Value="Verdana" />
                                    <Setter Property="FontSize" Value="14" />
                                    <Setter Property="FontStyle" Value="Italic" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="Padding" Value="10,10,10,10" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                    <Setter Property="BorderBrush" Value="#E0E0E0" />
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="White" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                    <Setter Property="BorderBrush" Value="#F0F0F0" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F9F9F9" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>

                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Padding" Value="10,10" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Foreground" Value="#1E1E1E" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>

                            <DataGrid.Columns>
                                <!--  Task Name  -->
                                <DataGridTextColumn
                                    Width="1.5*"
                                    Binding="{Binding TaskName}"
                                    Header="Task Name">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Padding" Value="10,10" />
                                            <Setter Property="FontFamily" Value="Verdana" />
                                            <Setter Property="FontSize" Value="14" />
                                            <Setter Property="Foreground" Value="#1E1E1E" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!--  Audit Name  -->
                                <DataGridTextColumn
                                    Width="1.5*"
                                    Binding="{Binding AuditName}"
                                    Header="Audit Name">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Padding" Value="10,10" />
                                            <Setter Property="FontFamily" Value="Verdana" />
                                            <Setter Property="FontSize" Value="14" />
                                            <Setter Property="Foreground" Value="#1e1e1e" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!--  Due Date  -->
                                <DataGridTextColumn
                                    Width="1*"
                                    Binding="{Binding DueDate, StringFormat=dd-MM-yyyy}"
                                    Header="Due Date">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Padding" Value="10,10" />
                                            <Setter Property="FontFamily" Value="Verdana" />
                                            <Setter Property="FontSize" Value="14" />
                                            <Setter Property="Foreground" Value="#1e1e1e" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!--  User  -->
                                <DataGridTextColumn
                                    Width="1.2*"
                                    Binding="{Binding AssignedToUser.FullName}"
                                    Header="Assigned To">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Padding" Value="10,10" />
                                            <Setter Property="FontFamily" Value="Verdana" />
                                            <Setter Property="FontSize" Value="14" />
                                            <Setter Property="Foreground" Value="#1e1e1e" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!--  Evidence Submitted  -->
                                <DataGridTextColumn
                                    Width="1*"
                                    Binding="{Binding EvidenceCountDisplay}"
                                    Header="Evidence Submitted">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Padding" Value="10,10" />
                                            <Setter Property="FontFamily" Value="Verdana" />
                                            <Setter Property="FontSize" Value="14" />
                                            <Setter Property="Foreground" Value="#1e1e1e" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!--  Task Status  -->
                                <DataGridTemplateColumn Width="1.5*" Header="Status">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border
                                                Width="120"
                                                Height="30"
                                                Padding="5,5"
                                                HorizontalAlignment="Left"
                                                CornerRadius="20"
                                                Cursor="Hand"
                                                MouseLeftButtonDown="StatusBorder_Click">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="NotStarted">
                                                                <Setter Property="Background" Value="#424242" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="InProgress">
                                                                <Setter Property="Background" Value="#0070A8" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="OnHold">
                                                                <Setter Property="Background" Value="#99237f" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                <Setter Property="Background" Value="#008015" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Overdue">
                                                                <Setter Property="Background" Value="#BD0000" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontFamily="Verdana"
                                                    FontSize="12"
                                                    FontWeight="Bold"
                                                    Foreground="White"
                                                    Text="{Binding StatusDisplay}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!--  Actions  -->
                                <DataGridTemplateColumn Width="1.5*" Header="Actions">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <!--  Edit Button  -->
                                                <Button
                                                    Width="18"
                                                    Height="18"
                                                    Margin="5,0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Click="EditTask_Click"
                                                    Tag="{Binding TaskId}">
                                                    <Button.ToolTip>
                                                        <ToolTip
                                                            Content="Edit Task"
                                                            FontFamily="Verdana"
                                                            FontSize="12" />
                                                    </Button.ToolTip>
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <ContentPresenter />
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <svgc:SvgViewbox
                                                        Width="18"
                                                        Height="18"
                                                        Source="/Resources/Svg/pen-to-square-solid-full.svg" />
                                                </Button>

                                                <!--  Delete Button  -->
                                                <Button
                                                    Width="18"
                                                    Height="18"
                                                    Margin="5,0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Click="DeleteTask_Click"
                                                    Tag="{Binding TaskId}">
                                                    <Button.ToolTip>
                                                        <ToolTip
                                                            Content="Delete Task"
                                                            FontFamily="Verdana"
                                                            FontSize="12" />
                                                    </Button.ToolTip>
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <ContentPresenter />
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <svgc:SvgViewbox
                                                        Width="18"
                                                        Height="18"
                                                        Source="/Resources/Svg/circle-xmark-solid-full.svg" />
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border
                    Width="1459"
                    Margin="0,0,0,25"
                    Padding="25"
                    Background="White"
                    BorderThickness="2"
                    CornerRadius="15">
                    <Border.BorderBrush>
                        <SolidColorBrush Opacity="0.2" Color="#FF1E1E1E" />
                    </Border.BorderBrush>
                    <StackPanel>
                        <Grid Margin="0,0,0,20">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="Verdana"
                                FontSize="22"
                                FontWeight="SemiBold"
                                Foreground="#FF1E1E1E"
                                Text="Create New Task" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  Task Name  -->
                            <StackPanel
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,15,20,15">
                                <TextBlock
                                    Margin="0,0,0,10"
                                    FontFamily="Verdana"
                                    FontSize="16"
                                    Foreground="#1e1e1e"
                                    Text="Task Name" />
                                <TextBox
                                    x:Name="TaskNameBox"
                                    Width="200"
                                    Height="35"
                                    Padding="8"
                                    VerticalContentAlignment="Center"
                                    FontFamily="Verdana"
                                    FontSize="14" />
                            </StackPanel>

                            <!--  Audit  -->
                            <StackPanel
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="0,15,20,15">
                                <TextBlock
                                    Margin="0,0,0,10"
                                    FontFamily="Verdana"
                                    FontSize="16"
                                    Foreground="#1e1e1e"
                                    Text="Audit" />
                                <ComboBox
                                    x:Name="TaskAuditComboBox"
                                    Width="200"
                                    Height="35"
                                    FontFamily="Verdana"
                                    FontSize="14" />
                            </StackPanel>

                            <!--  Assigned To  -->
                            <StackPanel
                                Grid.Row="0"
                                Grid.Column="2"
                                Margin="0,15,20,15">
                                <TextBlock
                                    Margin="0,0,0,10"
                                    FontFamily="Verdana"
                                    FontSize="16"
                                    Foreground="#1e1e1e"
                                    Text="Assigned To" />
                                <ComboBox
                                    x:Name="TaskAssignedToComboBox"
                                    Width="200"
                                    Height="35"
                                    FontFamily="Verdana"
                                    FontSize="14" />
                            </StackPanel>

                            <!--  Due Date  -->
                            <StackPanel
                                Grid.Row="1"
                                Grid.Column="0"
                                Margin="0,15,20,15">
                                <TextBlock
                                    Margin="0,0,0,10"
                                    FontFamily="Verdana"
                                    FontSize="16"
                                    Foreground="#1e1e1e"
                                    Text="Due Date" />
                                <DatePicker
                                    x:Name="TaskDueDatePicker"
                                    Width="200"
                                    Height="35"
                                    FontFamily="Verdana"
                                    FontSize="14" />
                            </StackPanel>

                            <!--  Description  -->
                            <StackPanel
                                Grid.Row="1"
                                Grid.Column="1"
                                Grid.ColumnSpan="2"
                                Margin="0,15,20,15">
                                <TextBlock
                                    Margin="0,0,0,10"
                                    FontFamily="Verdana"
                                    FontSize="16"
                                    Foreground="#1e1e1e"
                                    Text="Description (Optional)" />
                                <TextBox
                                    x:Name="TaskDescriptionBox"
                                    Width="420"
                                    Height="70"
                                    Padding="8"
                                    AcceptsReturn="True"
                                    FontFamily="Verdana"
                                    FontSize="14"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <!--  Save Button  -->
                            <StackPanel
                                Grid.Row="2"
                                Grid.Column="0"
                                Margin="0,10,0,0">
                                <Button
                                    Width="200"
                                    Height="45"
                                    HorizontalAlignment="Left"
                                    Click="SaveTask_Click"
                                    Content="Save Task"
                                    Style="{StaticResource DefaultManagerStyle}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  Evidence Review Section  -->
                <Border
                    Width="1444"
                    MinWidth="1459"
                    Margin="0,20,0,25"
                    Padding="25"
                    Background="White"
                    BorderThickness="2,2,2,2"
                    CornerRadius="10">
                    <Border.BorderBrush>
                        <SolidColorBrush Opacity="0.2" Color="#FF1E1E1E" />
                    </Border.BorderBrush>
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="8"
                            Opacity="0.1"
                            ShadowDepth="2"
                            Color="#000000" />
                    </Border.Effect>
                    <StackPanel>
                        <Grid Margin="0,0,0,20">
                            <TextBlock
                                Margin="0,0,916,0"
                                VerticalAlignment="Center"
                                FontFamily="Verdana"
                                FontSize="22"
                                FontWeight="SemiBold"
                                Foreground="#FF1E1E1E"
                                Text="Submitted Evidence - Pending Review" />
                        </Grid>
                        <ScrollViewer Height="550" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="PendingEvidencePanel" />
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!--  Reviewed Section  -->
                <Border
                    Width="1444"
                    MinWidth="1459"
                    Margin="0,20,0,25"
                    Padding="25"
                    Background="White"
                    BorderThickness="2,2,2,2"
                    CornerRadius="10">
                    <Border.BorderBrush>
                        <SolidColorBrush Opacity="0.2" Color="#FF1E1E1E" />
                    </Border.BorderBrush>
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="8"
                            Opacity="0.1"
                            ShadowDepth="2"
                            Color="#000000" />
                    </Border.Effect>
                    <StackPanel>
                        <Grid Margin="0,0,0,20">
                            <TextBlock
                                Margin="0,0,916,0"
                                VerticalAlignment="Center"
                                FontFamily="Verdana"
                                FontSize="22"
                                FontWeight="SemiBold"
                                Foreground="#FF1E1E1E"
                                Text="Reviewed Evidence" />
                            <StackPanel
                                Width="868"
                                Margin="537,0,0,0"
                                HorizontalAlignment="Left"
                                Orientation="Horizontal" />
                        </Grid>
                        <DataGrid
                            x:Name="ReviewedEvidenceGrid"
                            Height="300"
                            AutoGenerateColumns="False"
                            Background="White"
                            BorderThickness="0"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            GridLinesVisibility="None"
                            HeadersVisibility="Column"
                            IsReadOnly="True"
                            RowHeight="45"
                            SelectionMode="Single"
                            SelectionUnit="FullRow">

                            <!--  Header Style  -->
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="#1e1e1e" />
                                    <Setter Property="FontFamily" Value="Verdana" />
                                    <Setter Property="FontSize" Value="14" />
                                    <Setter Property="FontStyle" Value="Italic" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="Padding" Value="10,10,10,10" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                    <Setter Property="BorderBrush" Value="#E0E0E0" />
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <!--  Row Style  -->
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="White" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                    <Setter Property="BorderBrush" Value="#F0F0F0" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F9F9F9" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>

                            <!--  Cell Style  -->
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Padding" Value="10,10" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Foreground" Value="#1E1E1E" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>

                            <DataGrid.Columns>
                                <!--  Task Name  -->
                                <DataGridTextColumn
                                    Width="1.5*"
                                    Binding="{Binding Task.TaskName}"
                                    Header="Task Name">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Padding" Value="10,10" />
                                            <Setter Property="FontFamily" Value="Verdana" />
                                            <Setter Property="FontSize" Value="14" />
                                            <Setter Property="Foreground" Value="#1E1E1E" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!--  Audit Name  -->
                                <DataGridTextColumn
                                    Width="1.5*"
                                    Binding="{Binding Task.AuditName}"
                                    Header="Audit Name">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Padding" Value="10,10" />
                                            <Setter Property="FontFamily" Value="Verdana" />
                                            <Setter Property="FontSize" Value="14" />
                                            <Setter Property="Foreground" Value="#1e1e1e" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!--  Submiited by  -->
                                <DataGridTextColumn
                                    Width="1.2*"
                                    Binding="{Binding SubmittedBy.FullName}"
                                    Header="Submitted By">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Padding" Value="10,10" />
                                            <Setter Property="FontFamily" Value="Verdana" />
                                            <Setter Property="FontSize" Value="14" />
                                            <Setter Property="Foreground" Value="#1e1e1e" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!--  Due Date  -->
                                <DataGridTextColumn
                                    Width="1*"
                                    Binding="{Binding ReviewedDate, StringFormat=dd-MM-yyyy}"
                                    Header="Reviewed Date">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Padding" Value="10,10" />
                                            <Setter Property="FontFamily" Value="Verdana" />
                                            <Setter Property="FontSize" Value="14" />
                                            <Setter Property="Foreground" Value="#1e1e1e" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!--  Decision  -->
                                <DataGridTextColumn
                                    Width="0.8*"
                                    Binding="{Binding Status}"
                                    Header="Decision">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Padding" Value="10,10" />
                                            <Setter Property="FontFamily" Value="Verdana" />
                                            <Setter Property="FontSize" Value="14" />
                                            <Setter Property="Foreground" Value="#1e1e1e" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!--  Notes  -->
                                <DataGridTextColumn
                                    Width="1.5*"
                                    Binding="{Binding RejectionReason}"
                                    Header="Notes">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Padding" Value="10,10" />
                                            <Setter Property="FontFamily" Value="Verdana" />
                                            <Setter Property="FontSize" Value="14" />
                                            <Setter Property="Foreground" Value="#1e1e1e" />
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>