<UserControl
    x:Class="_02_AuditFlowApplication.Views.LoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:_02_AuditFlowApplication.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    KeyboardNavigation.TabNavigation="Cycle"
    mc:Ignorable="d">
    <Grid Width="1920" HorizontalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" MinWidth="1136" />
        </Grid.ColumnDefinitions>

        <!--  Logo Panel  -->
        <StackPanel
            Width="776"
            Height="1064"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            AutomationProperties.Name="AuditFlow branding panel">
            <Image
                Width="838"
                Height="1074"
                HorizontalAlignment="Center"
                AutomationProperties.HelpText="AuditFlow application logo"
                AutomationProperties.Name="AuditFlow logo"
                RenderTransformOrigin="0.496,0.496"
                Source="/Resources/PNG/TealLogoImage.png" />
        </StackPanel>

        <!--  Login Panel  -->
        <StackPanel
            Grid.Column="1"
            Width="1152"
            Height="1064"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            AutomationProperties.Name="Login panel"
            Background="White">

            <StackPanel Height="126">
                <Button
                    Margin="0,50,50,50"
                    Padding="0,10,0,10"
                    HorizontalAlignment="Right"
                    AutomationProperties.HelpText="Click to navigate to the manager login page"
                    AutomationProperties.Name="Switch to Manager Login"
                    Click="ManagerLoginButton_Click"
                    Content="Switch to Manager Login"
                    KeyboardNavigation.IsTabStop="True"
                    Style="{StaticResource DefaultTextStyle}"
                    TabIndex="3">
                    <Button.InputBindings>
                        <KeyBinding Key="Return" Command="{x:Null}" />
                    </Button.InputBindings>
                </Button>
            </StackPanel>

            <Grid
                Width="1148"
                Height="639"
                Margin="0,150,0,0">
                <Border
                    Height="480"
                    Margin="50,0,50,0"
                    Padding="30,30,30,30"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Login form"
                    Background="White"
                    BorderThickness="2,2,2,2"
                    CornerRadius="10">
                    <Border.BorderBrush>
                        <SolidColorBrush Opacity="0.2" Color="#FF1E1E1E" />
                    </Border.BorderBrush>
                    <StackPanel>
                        <TextBlock
                            Margin="0,5,0,10"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="Log Into AuditFlow heading"
                            FontFamily="Verdana"
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="#FF1E1E1E"
                            Text="Log Into AuditFlow" />

                        <TextBlock
                            Margin="0,5,0,30"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="Enter your account details below"
                            FontFamily="Verdana"
                            FontSize="18"
                            FontWeight="Regular"
                            Foreground="#FF1E1E1E"
                            Text="Enter your account details below:" />

                        <Label
                            AutomationProperties.Name="Username label"
                            Content="Username:"
                            FontFamily="Verdana"
                            FontSize="18"
                            Foreground="#FF1E1E1E"
                            Target="{Binding ElementName=UsernameTextBox}" />

                        <TextBox
                            x:Name="UsernameTextBox"
                            Margin="5,5,5,15"
                            AutomationProperties.HelpText="Enter your username"
                            AutomationProperties.LabeledBy="{x:Null}"
                            AutomationProperties.Name="Username"
                            FontSize="14"
                            KeyboardNavigation.IsTabStop="True"
                            TabIndex="0">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{x:Null}" />
                            </TextBox.InputBindings>
                        </TextBox>

                        <Label
                            Margin="0,10,0,0"
                            AutomationProperties.Name="Password label"
                            Content="Password:"
                            FontFamily="Verdana"
                            FontSize="18"
                            Foreground="#FF1E1E1E"
                            Target="{Binding ElementName=PasswordBox}" />

                        <PasswordBox
                            x:Name="PasswordBox"
                            Margin="5,5,5,25"
                            AutomationProperties.HelpText="Enter your password"
                            AutomationProperties.Name="Password"
                            FontSize="14"
                            KeyboardNavigation.IsTabStop="True"
                            TabIndex="1" />

                        <Button
                            x:Name="LoginButton"
                            Margin="5,20,5,5"
                            AutomationProperties.HelpText="Click or press Enter to sign in"
                            AutomationProperties.Name="Sign In"
                            Click="LoginButton_Click"
                            Content="Sign In"
                            IsDefault="True"
                            KeyboardNavigation.IsTabStop="True"
                            Style="{StaticResource DefaultAuditorStyle}"
                            TabIndex="2" />

                        <TextBlock
                            Margin="0,15,0,0"
                            HorizontalAlignment="Center"
                            AutomationProperties.Name="Default credentials hint"
                            FontSize="11"
                            Foreground="Gray"
                            Text="Default credentials: admin / admin123"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
