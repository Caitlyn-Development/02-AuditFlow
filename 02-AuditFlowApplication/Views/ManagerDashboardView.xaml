<UserControl
    x:Class="_02_AuditFlowApplication.Views.ManagerDashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:_02_AuditFlowApplication"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:svgc="clr-namespace:SharpVectors.Converters;assembly=SharpVectors.Converters.Wpf"
    xmlns:views="clr-namespace:_02_AuditFlowApplication.Views"
    AutomationProperties.HelpText="System wide dashboard showing all audit statistics, calendar, and upcoming deadlines"
    AutomationProperties.Name="Manager dashboard"
    Background="#FFFFFF"
    KeyboardNavigation.TabNavigation="Cycle"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  Card Style  -->
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="10,0" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
                        BlurRadius="8"
                        Opacity="0.1"
                        ShadowDepth="2"
                        Color="#000000" />
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Section Header Style  -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,20,0,15" />
            <Setter Property="Foreground" Value="#333333" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <views:ManagerLayout
            x:Name="Layout"
            Grid.Row="0"
            Grid.RowSpan="2" />

        <!--  Main Dashboard Content  -->
        <ScrollViewer
            Grid.Row="1"
            Height="944"
            Margin="251,120,0,0"
            Padding="30,20"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Width="1589">
                <!--  Dashboard Header  -->
                <TextBlock
                    Width="1121"
                    Margin="10,0,0,25"
                    HorizontalAlignment="Left"
                    FontFamily="Verdana"
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="#FF1E1E1E"
                    Text="Dashboard" />

                <!--  Statistics Cards Row  -->
                <Grid Width="1453" Margin="0,0,0,40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Name="TotalAudits" Width="Auto" />
                        <ColumnDefinition Name="InProgressAudits" Width="Auto" />
                        <ColumnDefinition Name="CompletedAudits" Width="Auto" />
                        <ColumnDefinition Name="OverdueAudits" Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  Total Audits Card  -->
                    <Border
                        Grid.Column="0"
                        Width="227"
                        Height="110"
                        Margin="24,0,50,0"
                        Padding="10,10,10,10"
                        VerticalAlignment="Center"
                        AutomationProperties.HelpText="Shows the total number of audits in the system"
                        AutomationProperties.Name="Total Audits stat card"
                        BorderThickness="2,2,2,2"
                        CornerRadius="15,15,15,15"
                        Focusable="True"
                        Style="{StaticResource StatCardStyle}">
                        <Border.BorderBrush>
                            <SolidColorBrush Opacity="0.2" Color="#FF1E1E1E" />
                        </Border.BorderBrush>
                        <StackPanel>
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Name="CardTitle" Width="*" />
                                    <ColumnDefinition Name="CardIcon" Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Width="139"
                                    Padding="0,5,0,5"
                                    HorizontalAlignment="Left"
                                    FontFamily="Verdana"
                                    FontSize="18"
                                    Foreground="#FF1E1E1E"
                                    Text="Total Audits" />
                                <Border
                                    Grid.Column="1"
                                    Width="30"
                                    Height="30"
                                    Margin="70,0,0,0"
                                    VerticalAlignment="Top"
                                    CornerRadius="4">
                                    <svgc:SvgViewbox
                                        Width="30"
                                        Height="30"
                                        Source="/Resources/Svg/business-time-solid-full.svg" />
                                </Border>
                            </Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    FontFamily="Verdana"
                                    FontSize="20"
                                    FontWeight="Bold"
                                    Foreground="#FF1E1E1E"
                                    Text="{Binding TotalAudits}" />
                            </StackPanel>
                            <TextBlock
                                Padding="0,5,0,5"
                                FontFamily="Verdana"
                                FontSize="14"
                                Foreground="#FF1E1E1E"
                                Text="Total audits assigned"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!--  Audits In Progress Card  -->
                    <Border
                        Grid.Column="1"
                        Width="227"
                        Height="110"
                        Margin="0,0,50,0"
                        Padding="10,10,10,10"
                        VerticalAlignment="Center"
                        AutomationProperties.HelpText="Shows the number of currently active audits across the system"
                        AutomationProperties.Name="Audits In Progress stat card"
                        BorderThickness="2,2,2,2"
                        CornerRadius="15,15,15,15"
                        Focusable="True"
                        Style="{StaticResource StatCardStyle}">
                        <Border.BorderBrush>
                            <SolidColorBrush Opacity="0.2" Color="#FF1E1E1E" />
                        </Border.BorderBrush>
                        <StackPanel>
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Margin="0,0,36,0"
                                    Padding="0,5,0,5"
                                    FontFamily="Verdana"
                                    FontSize="18"
                                    Foreground="#FF1E1E1E"
                                    Text="Audits In Progress" />
                                <Border
                                    Grid.Column="1"
                                    Width="30"
                                    Height="30"
                                    Margin="70,0,0,0"
                                    VerticalAlignment="Top"
                                    CornerRadius="4">
                                    <svgc:SvgViewbox
                                        Width="30"
                                        Height="30"
                                        Source="/Resources/Svg/list-solid-full.svg" />
                                </Border>
                            </Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    FontFamily="Verdana"
                                    FontSize="20"
                                    FontWeight="Bold"
                                    Foreground="#FF1E1E1E"
                                    Text="{Binding AuditsInProgress}" />
                            </StackPanel>
                            <TextBlock
                                Margin="0,5,0,0"
                                Padding="0,5,0,5"
                                FontFamily="Verdana"
                                FontSize="14"
                                Foreground="#FF1E1E1E"
                                Text="Currently active audits"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!--  Completed Audits Card  -->
                    <Border
                        Grid.Column="2"
                        Width="227"
                        Height="110"
                        Margin="0,0,50,0"
                        Padding="10,10,10,10"
                        VerticalAlignment="Center"
                        AutomationProperties.HelpText="Shows the number of closed audits across the system"
                        AutomationProperties.Name="Completed Audits stat card"
                        BorderThickness="2,2,2,2"
                        CornerRadius="15,15,15,15"
                        Focusable="True"
                        Style="{StaticResource StatCardStyle}">
                        <Border.BorderBrush>
                            <SolidColorBrush Opacity="0.2" Color="#FF1E1E1E" />
                        </Border.BorderBrush>
                        <StackPanel>
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Margin="0,0,39,0"
                                    Padding="0,5,0,5"
                                    FontFamily="Verdana"
                                    FontSize="18"
                                    Foreground="#FF1E1E1E"
                                    Text="Completed Audits" />
                                <Border
                                    Grid.Column="1"
                                    Width="30"
                                    Height="30"
                                    Margin="70,0,0,0"
                                    VerticalAlignment="Top"
                                    CornerRadius="4">
                                    <svgc:SvgViewbox
                                        Width="30"
                                        Height="30"
                                        Source="/Resources/Svg/square-check-regular-full.svg" />
                                </Border>
                            </Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    FontFamily="Verdana"
                                    FontSize="20"
                                    FontWeight="Bold"
                                    Foreground="#FF1E1E1E"
                                    Text="{Binding CompletedAudits}" />
                            </StackPanel>
                            <TextBlock
                                Margin="0,5,0,0"
                                Padding="0,5,0,5"
                                FontFamily="Verdana"
                                FontSize="14"
                                Foreground="#FF1E1E1E"
                                Text="Closed audits"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!--  Overdue Audits Card  -->
                    <Border
                        Grid.Column="3"
                        Width="227"
                        Height="110"
                        Margin="0,0,50,0"
                        Padding="10,10,10,10"
                        VerticalAlignment="Center"
                        AutomationProperties.HelpText="Shows the number of audits past their due date across the system"
                        AutomationProperties.Name="Overdue Audits stat card"
                        BorderThickness="2,2,2,2"
                        CornerRadius="15,15,15,15"
                        Focusable="True"
                        Style="{StaticResource StatCardStyle}">
                        <Border.BorderBrush>
                            <SolidColorBrush Opacity="0.2" Color="#FF1E1E1E" />
                        </Border.BorderBrush>
                        <StackPanel>
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Margin="0,0,53,0"
                                    Padding="0,5,0,5"
                                    FontFamily="Verdana"
                                    FontSize="18"
                                    Foreground="#FF1E1E1E"
                                    Text="Overdue Audits" />
                                <Border
                                    Grid.Column="1"
                                    Width="30"
                                    Height="30"
                                    Margin="70,0,0,0"
                                    VerticalAlignment="Top"
                                    CornerRadius="4">
                                    <svgc:SvgViewbox
                                        Width="30"
                                        Height="30"
                                        Source="/Resources/Svg/flag-regular-full.svg" />
                                </Border>
                            </Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    FontFamily="Verdana"
                                    FontSize="20"
                                    FontWeight="Bold"
                                    Foreground="#FF1E1E1E"
                                    Text="{Binding OverdueAudits}" />
                            </StackPanel>
                            <TextBlock
                                Margin="0,5,0,0"
                                Padding="0,5,0,5"
                                FontFamily="Verdana"
                                FontSize="14"
                                Foreground="#FF1E1E1E"
                                Text="Audits past due date"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!--  Calendar Section  -->
                <Border
                    Width="1459"
                    Margin="0,0,0,25"
                    Padding="25"
                    AutomationProperties.HelpText="Monthly calendar showing all scheduled audit events across the system"
                    AutomationProperties.Name="Audit calendar"
                    Background="White"
                    BorderThickness="2,2,2,2"
                    CornerRadius="10">
                    <Border.BorderBrush>
                        <SolidColorBrush Opacity="0.2" Color="#FF1E1E1E" />
                    </Border.BorderBrush>
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="8"
                            Opacity="0.1"
                            ShadowDepth="2"
                            Color="#000000" />
                    </Border.Effect>

                    <StackPanel>
                        <!--  Calendar Header  -->
                        <Grid Margin="0,0,0,20">
                            <TextBlock
                                Margin="0,0,1287,0"
                                VerticalAlignment="Center"
                                FontFamily="Verdana"
                                FontSize="22"
                                FontWeight="SemiBold"
                                Foreground="#FF1E1E1E"
                                Text="Calendar" />

                            <StackPanel
                                Width="891"
                                Margin="514,0,0,0"
                                HorizontalAlignment="Left"
                                Orientation="Horizontal">
                                <Button
                                    x:Name="PrevMonthButton"
                                    Width="35"
                                    Height="35"
                                    Margin="0,0,10,0"
                                    AutomationProperties.HelpText="Navigate to the previous month on the calendar"
                                    AutomationProperties.Name="Previous month"
                                    Background="#F5F5F5"
                                    BorderThickness="2,2,2,2"
                                    Content="◀"
                                    Cursor="Hand"
                                    KeyboardNavigation.TabIndex="0">
                                    <Button.BorderBrush>
                                        <SolidColorBrush Opacity="0.2" Color="#FF1E1E1E" />
                                    </Button.BorderBrush>
                                </Button>
                                <TextBlock
                                    x:Name="CalendarMonthYear"
                                    Margin="10,0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Current calendar month"
                                    FontFamily="Verdana"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="#FF1E1E1E"
                                    Text="October 2026" />
                                <Button
                                    x:Name="NextMonthButton"
                                    Width="35"
                                    Height="35"
                                    Margin="10,0,0,0"
                                    AutomationProperties.HelpText="Navigate to the next month on the calendar"
                                    AutomationProperties.Name="Next month"
                                    Background="#F5F5F5"
                                    BorderThickness="2,2,2,2"
                                    Content="▶"
                                    Cursor="Hand"
                                    KeyboardNavigation.TabIndex="1">
                                    <Button.BorderBrush>
                                        <SolidColorBrush Opacity="0.2" Color="#FF1E1E1E" />
                                    </Button.BorderBrush>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!--  Calendar Grid  -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  Day Headers  -->
                            <UniformGrid
                                Grid.Row="0"
                                Margin="0,0,0,10"
                                AutomationProperties.Name="Calendar day headers"
                                Columns="7"
                                Rows="1">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    AutomationProperties.Name="Monday"
                                    FontFamily="Verdana"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="#999999"
                                    Text="Mon" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    AutomationProperties.Name="Tuesday"
                                    FontFamily="Verdana"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="#999999"
                                    Text="Tue" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    AutomationProperties.Name="Wednesday"
                                    FontFamily="Verdana"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="#999999"
                                    Text="Wed" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    AutomationProperties.Name="Thursday"
                                    FontFamily="Verdana"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="#999999"
                                    Text="Thur" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    AutomationProperties.Name="Friday"
                                    FontFamily="Verdana"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="#999999"
                                    Text="Fri" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    AutomationProperties.Name="Saturday"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="#999999"
                                    Text="Sat" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    AutomationProperties.Name="Sunday"
                                    FontFamily="Verdana"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="#999999"
                                    Text="Sun" />
                            </UniformGrid>

                            <!--  Calendar Days  -->
                            <UniformGrid
                                x:Name="CalendarGrid"
                                Grid.Row="1"
                                AutomationProperties.HelpText="Five week calendar grid showing audit events for the selected month"
                                AutomationProperties.Name="Calendar grid"
                                Columns="7"
                                Rows="5">
                                <Border
                                    Height="80"
                                    Margin="2"
                                    Background="#F8F8F8"
                                    BorderBrush="#E0E0E0"
                                    BorderThickness="1">
                                    <StackPanel Margin="8">
                                        <TextBlock
                                            FontSize="14"
                                            Foreground="#666"
                                            Text="1" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  Upcoming Deadlines Section  -->
                <Border
                    Width="1495"
                    Margin="0,10,0,0"
                    Padding="25"
                    AutomationProperties.HelpText="Lists all audits due this month that have not been completed across the system"
                    AutomationProperties.Name="Upcoming deadlines section"
                    Background="White"
                    BorderThickness="2"
                    CornerRadius="8">
                    <Border.BorderBrush>
                        <SolidColorBrush Opacity="0.2" Color="#FF1E1E1E" />
                    </Border.BorderBrush>
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="8"
                            Opacity="0.1"
                            ShadowDepth="2"
                            Color="#000000" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,20"
                            FontFamily="Verdana"
                            FontSize="22"
                            Foreground="#FF1E1E1E"
                            Style="{StaticResource SectionHeaderStyle}"
                            Text="Upcoming Deadlines" />

                        <DataGrid
                            x:Name="UpcomingDeadlinesGrid"
                            AutoGenerateColumns="False"
                            AutomationProperties.HelpText="Table of system wide audits due this month. Use arrow keys to navigate rows."
                            AutomationProperties.Name="Upcoming deadlines table"
                            Background="White"
                            BorderThickness="0"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            GridLinesVisibility="None"
                            HeadersVisibility="Column"
                            IsReadOnly="True"
                            KeyboardNavigation.TabIndex="2"
                            RowHeight="50"
                            SelectionMode="Single"
                            SelectionUnit="FullRow">

                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F8F9FA" />
                                    <Setter Property="Foreground" Value="#666666" />
                                    <Setter Property="FontFamily" Value="Verdana" />
                                    <Setter Property="FontSize" Value="13" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Padding" Value="15,10" />
                                    <Setter Property="BorderThickness" Value="0" />
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="White" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                    <Setter Property="BorderBrush" Value="#F0F0F0" />
                                </Style>
                            </DataGrid.RowStyle>

                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Padding" Value="15,10" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Foreground" Value="#1E1E1E" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>

                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="2*"
                                    Binding="{Binding AuditName}"
                                    Header="Audit Name">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Padding" Value="15,0" />
                                            <Setter Property="FontFamily" Value="Verdana" />
                                            <Setter Property="FontSize" Value="14" />
                                            <Setter Property="Foreground" Value="#333333" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding Type}"
                                    Header="Type of Audit">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Padding" Value="15,0" />
                                            <Setter Property="FontFamily" Value="Verdana" />
                                            <Setter Property="FontSize" Value="14" />
                                            <Setter Property="Foreground" Value="#666666" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding EndDate, StringFormat=dd-MM-yyyy}"
                                    Header="Due Date">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Padding" Value="15,0" />
                                            <Setter Property="FontFamily" Value="Verdana" />
                                            <Setter Property="FontSize" Value="14" />
                                            <Setter Property="Foreground" Value="#666666" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Width="*" Header="Status">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border
                                                Margin="15,0"
                                                Padding="12,6"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                CornerRadius="12">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#F5F5F5" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="InProgress">
                                                                <Setter Property="Background" Value="#E3F2FD" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="NotStarted">
                                                                <Setter Property="Background" Value="#F5F5F5" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Overdue">
                                                                <Setter Property="Background" Value="#FFEBEE" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock
                                                    FontFamily="Verdana"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding StatusDisplay}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#666666" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="InProgress">
                                                                    <Setter Property="Foreground" Value="#2196F3" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Overdue">
                                                                    <Setter Property="Foreground" Value="#BD0000" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock
                            x:Name="NoDeadlinesText"
                            Margin="15,20"
                            AutomationProperties.Name="No upcoming deadlines this month"
                            FontFamily="Verdana"
                            FontSize="14"
                            Foreground="#999999"
                            Text="No upcoming deadlines this month."
                            Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>