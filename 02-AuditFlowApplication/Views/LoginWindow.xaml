<UserControl x:Class="_02_AuditFlowApplication.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_02_AuditFlowApplication.Views"
        mc:Ignorable="d">
    <Grid HorizontalAlignment="Center" Width="1920">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto" MinWidth="1136"/>
        </Grid.ColumnDefinitions>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Height="1064" Width="776">
            <Image Source="/Resources/PNG/TealLogoImage.png" Height="1074" RenderTransformOrigin="0.496,0.496" Width="838" HorizontalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Height="1064" HorizontalAlignment="Center" Width="1152">
            <StackPanel Height="126">
                <Button Content="Switch to Manager Login" FontFamily="Verdana" Foreground="#FF1E1E1E" FontSize="18" FontWeight="Bold" Height="46" HorizontalAlignment="Right" Margin="0,50,50,50" Padding="0,10,0,10" Click="ManagerLoginButton_Click" Background="Transparent"/>
            </StackPanel>
            <Grid Height="639" Width="1148" Margin="0,150,0,0">
                <Border Background="White" 
        CornerRadius="10" 
        Padding="30,30,30,30"
        BorderThickness="2,2,2,2" Margin="50,0,50,0" Height="480" VerticalAlignment="Center">
                    <Border.BorderBrush>
                        <SolidColorBrush Color="#FF1E1E1E" Opacity="0.2"/>
                    </Border.BorderBrush>
                    <StackPanel>
                        <TextBlock 
                   FontSize="20" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Left"
                   Foreground="#FF1E1E1E" FontFamily="Verdana" Margin="0,5,0,10"
                   Text="Log Into AuditFlow"/>
                        <TextBlock
                        FontSize="18"
                        FontWeight="Regular"
                        HorizontalAlignment="Left"
                        Foreground="#FF1E1E1E" FontFamily="Verdana" Margin="0,5,0,30"
                        Text="Enter your account details below:"/>
                        <Label Content="Username:" FontSize="18" FontFamily="Verdana" Foreground="#FF1E1E1E"/>
                        <TextBox x:Name="UsernameTextBox" 
                 FontSize="14"
                 TabIndex="0" Margin="5,5,5,15"/>

                        <Label Content="Password:" FontSize="18" Margin="0,10,0,0" FontFamily="Verdana" Foreground="#FF1E1E1E"/>
                        <PasswordBox x:Name="PasswordBox" 
                     FontSize="14"
                     TabIndex="1" Margin="5,5,5,25"/>

                        <Button x:Name="LoginButton" 
                Content="Sign In" 
                Click="LoginButton_Click"
                FontSize="14"
                FontFamily="Verdana"
                FontWeight="Bold"
                FontStyle="Italic"
                Height="40"
                Margin="5,20,5,5"
                TabIndex="2" Background="#FF003B49" Width="100"/>

                        <TextBlock Text="Default credentials: admin / Admin123!" 
                   FontSize="11" 
                   Foreground="Gray" 
                   HorizontalAlignment="Center" 
                   Margin="0,15,0,0"
                   TextWrapping="Wrap"
                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
