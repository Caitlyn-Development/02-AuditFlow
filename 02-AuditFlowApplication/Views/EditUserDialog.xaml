<Window
    x:Class="_02_AuditFlowApplication.Views.EditUserDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Edit User"
    Width="400"
    Height="450"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen">
    <StackPanel Margin="25">
        <TextBlock
            Margin="0,0,0,5"
            FontFamily="Verdana"
            FontSize="14"
            Text="Full Name" />
        <TextBox
            x:Name="FullNameBox"
            Height="35"
            Margin="0,0,0,15"
            Padding="8"
            FontFamily="Verdana"
            FontSize="14" />

        <TextBlock
            Margin="0,0,0,5"
            FontFamily="Verdana"
            FontSize="14"
            Text="New Password (leave blank to keep current)" />
        <PasswordBox
            x:Name="PasswordBox"
            Height="35"
            Margin="0,0,0,15"
            Padding="8"
            FontFamily="Verdana"
            FontSize="14" />

        <TextBlock
            Margin="0,0,0,5"
            FontFamily="Verdana"
            FontSize="14"
            Text="Role" />
        <ComboBox
            x:Name="RoleComboBox"
            Height="35"
            Margin="0,0,0,15"
            Padding="8"
            FontFamily="Verdana"
            FontSize="14">
            <ComboBoxItem Content="Auditor" />
            <ComboBoxItem Content="Manager" />
        </ComboBox>

        <TextBlock
            Margin="0,0,0,5"
            FontFamily="Verdana"
            FontSize="14"
            Text="Status" />
        <ComboBox
            x:Name="StatusComboBox"
            Height="35"
            Margin="0,0,0,25"
            Padding="8"
            FontFamily="Verdana"
            FontSize="14">
            <ComboBoxItem Content="Active" />
            <ComboBoxItem Content="Inactive" />
        </ComboBox>

        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
            <Button
                x:Name="CancelButton"
                Width="100"
                Height="38"
                Margin="0,0,10,0"
                Click="CancelButton_Click"
                Content="Cancel"
                FontFamily="Verdana"
                FontSize="14" />
            <Button
                x:Name="SaveButton"
                Width="100"
                Height="38"
                Background="#FF5D3754"
                Click="SaveButton_Click"
                Content="Save"
                FontFamily="Verdana"
                FontSize="14"
                FontWeight="Bold"
                Foreground="White" />
        </StackPanel>
    </StackPanel>
</Window>
