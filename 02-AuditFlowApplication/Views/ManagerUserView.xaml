<UserControl
    x:Class="_02_AuditFlowApplication.Views.ManagerUserView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:_02_AuditFlowApplication"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
    Background="#FFFFFF"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  Button Style  -->
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="15,10" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F0F0" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  Card Style  -->
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="10,0" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
                        BlurRadius="8"
                        Opacity="0.1"
                        ShadowDepth="2"
                        Color="#000000" />
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Section Header Style  -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,20,0,15" />
            <Setter Property="Foreground" Value="#333333" />
        </Style>

        <!--  Combo Box Style  -->
        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton
                                x:Name="ToggleButton"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#1e1e1e"
                                BorderThickness="2"
                                ClickMode="Press"
                                Focusable="False"
                                IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid Background="{TemplateBinding Background}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!--  Selected Item Display  -->
                                            <ContentPresenter
                                                Grid.Column="0"
                                                Margin="20,0,0,0"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Content="{TemplateBinding Content}"
                                                ContentTemplate="{TemplateBinding ContentTemplate}" />

                                            <!--  Dropdown Arrow  -->
                                            <Path
                                                Grid.Column="1"
                                                Width="12"
                                                Height="8"
                                                Margin="0,0,20,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Data="M 0 0 L 4 4 L 8 0 Z"
                                                Fill="#1E1E1E"
                                                Stretch="Uniform" />
                                        </Grid>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!--  Dropdown Popup  -->
                            <Popup
                                x:Name="Popup"
                                AllowsTransparency="True"
                                Focusable="False"
                                IsOpen="{TemplateBinding IsDropDownOpen}"
                                Placement="Bottom"
                                PopupAnimation="Slide">
                                <Border
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    Margin="0,4,0,0"
                                    Background="White"
                                    BorderBrush="#E0E0E0"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <Border.Effect>
                                        <DropShadowEffect
                                            BlurRadius="10"
                                            Opacity="0.2"
                                            ShadowDepth="2"
                                            Color="#000000" />
                                    </Border.Effect>
                                    <ScrollViewer Margin="0,4">
                                        <StackPanel IsItemsHost="True" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Combo Box Item Style  -->
        <Style x:Key="ComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="FontFamily" Value="Verdana" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="#1E1E1E" />
            <Setter Property="Padding" Value="20,12" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderThickness="0">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F5F5F5" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#E3F2FD" />
                                <Setter Property="Foreground" Value="#2196F3" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Top Navigation Bar  -->
        <Border
            Height="120"
            VerticalAlignment="Center"
            Background="White"
            BorderBrush="#E0E0E0"
            BorderThickness="0,0,0,1">
            <Grid Margin="0,0,0,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Logo and Title  -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Image
                        x:Name="Logo"
                        Width="206"
                        Height="86"
                        Margin="250,0,0,0"
                        Source="/Resources/PNG/AuditFlow Purple Logo.png" />
                </StackPanel>

                <!--  Right Side Icons  -->
                <StackPanel
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Margin="1092,0,0,0"
                    Orientation="Horizontal">
                    <Button
                        Width="50"
                        Height="50"
                        Margin="5,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand">
                        <svgc:SvgViewbox Source="/Resources/Svg/gear-solid-full.svg" />
                    </Button>
                    <Button
                        Width="50"
                        Height="50"
                        Margin="5,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Content="●"
                        Cursor="Hand"
                        FontSize="20"
                        Foreground="Black" />
                    <Button
                        x:Name="LogoutButton"
                        Width="50"
                        Height="50"
                        Margin="5,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand">
                        <svgc:SvgViewbox Source="/Resources/Svg/arrow-right-from-bracket-solid-full.svg" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  Main Content Area  -->
        <Grid
            Grid.Row="1"
            Height="944"
            VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="251" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  Left Sidebar Menu  -->
            <Border
                Grid.Column="0"
                Height="944"
                Padding="15,20"
                VerticalAlignment="Center"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,1,0">
                <StackPanel>
                    <Button
                        x:Name="DashboardButton"
                        Background="#E3F2FD"
                        Content="Dashboard"
                        FontFamily="Verdana"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="#2196F3"
                        Style="{StaticResource MenuButtonStyle}" />

                    <Button
                        x:Name="AuditsButton"
                        Content="Audits"
                        FontFamily="Verdana"
                        FontSize="16"
                        Foreground="#FF1E1E1E"
                        Style="{StaticResource MenuButtonStyle}" />

                    <Button
                        x:Name="TasksButton"
                        Content="Tasks"
                        FontFamily="Verdana"
                        FontSize="16"
                        Foreground="#FF1E1E1E"
                        Style="{StaticResource MenuButtonStyle}" />

                    <Button
                        x:Name="UsersButton"
                        Content="Users"
                        FontFamily="Verdana"
                        FontSize="16"
                        Foreground="#FF1E1E1E"
                        Style="{StaticResource MenuButtonStyle}" />

                    <Separator Margin="0,15" Background="#E0E0E0" />
                </StackPanel>
            </Border>

            <!--  Main Dashboard Content  -->
            <ScrollViewer
                x:Name="AuditsViewer"
                Grid.Column="1"
                Height="944"
                Padding="30,20"
                VerticalAlignment="Center"
                VerticalScrollBarVisibility="Auto">
                <StackPanel Width="1589">
                    <!--  Dashboard Header  -->
                    <TextBlock
                        Width="1121"
                        Margin="10,0,0,25"
                        HorizontalAlignment="Left"
                        FontFamily="Verdana"
                        FontSize="22"
                        FontWeight="Bold"
                        Foreground="#FF1E1E1E"
                        Text="User Managment" />

                    <!--  Users Section  -->
                    <Border
                        Width="1459"
                        Height="383"
                        Margin="0,0,0,25"
                        Padding="25"
                        Background="White"
                        BorderThickness="2,2,2,2"
                        CornerRadius="15">
                        <Border.BorderBrush>
                            <SolidColorBrush Opacity="0.2" Color="#FF1E1E1E" />
                        </Border.BorderBrush>
                        <StackPanel>

                            <!--  Users Header  -->
                            <Grid Margin="0,0,0,20">
                                <TextBlock
                                    Margin="0,0,1141,0"
                                    VerticalAlignment="Center"
                                    FontFamily="Verdana"
                                    FontSize="22"
                                    FontWeight="SemiBold"
                                    Foreground="#FF1E1E1E"
                                    Text="User Accounts" />
                            </Grid>

                            <!--  Users Display Grid  -->
                            <DataGrid
                                x:Name="UsersGrid"
                                Height="284"
                                AutoGenerateColumns="False"
                                Background="White"
                                BorderThickness="0"
                                CanUserAddRows="False"
                                CanUserDeleteRows="False"
                                GridLinesVisibility="None"
                                HeadersVisibility="Column"
                                IsReadOnly="True"
                                RowHeight="45"
                                SelectionMode="Single"
                                SelectionUnit="FullRow">

                                <!--  Header Style  -->
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="#1e1e1e" />
                                        <Setter Property="FontFamily" Value="Verdana" />
                                        <Setter Property="FontSize" Value="14" />
                                        <Setter Property="FontStyle" Value="Italic" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                        <Setter Property="Padding" Value="10,10,10,10" />
                                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                                        <Setter Property="BorderBrush" Value="#E0E0E0" />
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>

                                <!--  Row Style  -->
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Background" Value="White" />
                                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                                        <Setter Property="BorderBrush" Value="#F0F0F0" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F9F9F9" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>

                                <!--  Cell Style  -->
                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Padding" Value="10,10" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="Foreground" Value="#1E1E1E" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.CellStyle>

                                <DataGrid.Columns>
                                    <!--  Username  -->
                                    <DataGridTextColumn
                                        Width="2.5*"
                                        Binding="{Binding Username}"
                                        Header="Username">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Padding" Value="10,10" />
                                                <Setter Property="FontFamily" Value="Verdana" />
                                                <Setter Property="FontSize" Value="14" />
                                                <Setter Property="Foreground" Value="#1E1E1E" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!--  Fullname  -->
                                    <DataGridTextColumn
                                        Width="*"
                                        Binding="{Binding FullName}"
                                        Header="Full Name">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Padding" Value="10,10" />
                                                <Setter Property="FontFamily" Value="Verdana" />
                                                <Setter Property="FontSize" Value="14" />
                                                <Setter Property="Foreground" Value="#1e1e1e" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!--  Role  -->
                                    <DataGridTextColumn
                                        Width="1.5*"
                                        Binding="{Binding Role}"
                                        Header="Role">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Padding" Value="10,10" />
                                                <Setter Property="FontFamily" Value="Verdana" />
                                                <Setter Property="FontSize" Value="14" />
                                                <Setter Property="Foreground" Value="#1e1e1e" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!--  Status  -->
                                    <DataGridTextColumn
                                        Width="1.5*"
                                        Binding="{Binding IsActive}"
                                        Header="Status">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Padding" Value="10,10" />
                                                <Setter Property="FontFamily" Value="Verdana" />
                                                <Setter Property="FontSize" Value="14" />
                                                <Setter Property="Foreground" Value="#1e1e1e" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!--  Actions  -->
                                    <DataGridTemplateColumn Width="auto" Header="Actions">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <!--  Edit Button  -->
                                                    <Button
                                                        Width="18"
                                                        Height="18"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Click="EditUser_Click"
                                                        Tag="{Binding UserID}">
                                                        <Button.ToolTip>
                                                            <ToolTip
                                                                Content="Edit User"
                                                                FontFamily="Verdana"
                                                                FontSize="12" />
                                                        </Button.ToolTip>
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <ContentPresenter />
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <svgc:SvgViewbox
                                                            Width="18"
                                                            Height="18"
                                                            Source="/Resources/Svg/pen-to-square-solid-full.svg" />
                                                    </Button>

                                                    <!--  Delete Button  -->
                                                    <Button
                                                        Width="18"
                                                        Height="18"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Click="DeleteUser_Click"
                                                        Tag="{Binding UserID}">
                                                        <Button.ToolTip>
                                                            <ToolTip
                                                                Content="Delete User"
                                                                FontFamily="Verdana"
                                                                FontSize="12" />
                                                        </Button.ToolTip>
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <ContentPresenter />
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <svgc:SvgViewbox
                                                            Width="18"
                                                            Height="18"
                                                            Source="/Resources/Svg/circle-xmark-solid-full.svg" />
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!--  Create Audits Section  -->
                    <Border
                        Width="1459"
                        Height="383"
                        Margin="0,0,0,25"
                        Padding="25"
                        Background="White"
                        BorderThickness="2,2,2,2"
                        CornerRadius="15">
                        <Border.BorderBrush>
                            <SolidColorBrush Opacity="0.2" Color="#FF1E1E1E" />
                        </Border.BorderBrush>
                        <StackPanel>
                            <!--  Audits Header  -->
                            <Grid Margin="0,0,0,20">
                                <TextBlock
                                    Margin="0,0,1141,0"
                                    VerticalAlignment="Bottom"
                                    FontFamily="Verdana"
                                    FontSize="22"
                                    FontWeight="SemiBold"
                                    Foreground="#FF1E1E1E"
                                    Text="Create User Account" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="0,15,0,15"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        Margin="5,0,0,0"
                                        FontFamily="Verdana"
                                        FontSize="16"
                                        Foreground="#1e1e1e"
                                        Text="Username" />
                                    <TextBox
                                        x:Name="UsernameBox"
                                        Width="200"
                                        Height="40"
                                        Padding="8"
                                        FontFamily="Verdana"
                                        FontSize="14" />
                                </StackPanel>

                                <StackPanel
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="10,15,10,15"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        Margin="5,0,0,0"
                                        FontFamily="Verdana"
                                        FontSize="16"
                                        Foreground="#1e1e1e"
                                        Text="Full Name" />
                                    <TextBox
                                        x:Name="FullNameBox"
                                        Width="200"
                                        Height="40"
                                        Padding="8"
                                        FontFamily="Verdana"
                                        FontSize="14" />
                                </StackPanel>

                                <StackPanel
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    Margin="10,15,10,15"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        Margin="5,0,0,0"
                                        FontFamily="Verdana"
                                        FontSize="16"
                                        Foreground="#1e1e1e"
                                        Text="Role" />
                                    <ComboBox
                                        x:Name="RoleComboBox"
                                        Width="200"
                                        Height="40"
                                        Padding="8"
                                        FontFamily="Verdana"
                                        FontSize="14">
                                        <ComboBoxItem Content="Auditor" />
                                        <ComboBoxItem Content="Manager" />
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,15,10,15"
                                    HorizontalAlignment="Left">
                                    <TextBlock
                                        Margin="5,0,0,0"
                                        FontFamily="Verdana"
                                        FontSize="16"
                                        Foreground="#1e1e1e"
                                        Text="Password" />
                                    <PasswordBox
                                        x:Name="PasswordBox"
                                        Width="200"
                                        Height="40"
                                        Padding="8"
                                        FontFamily="Verdana"
                                        FontSize="14" />
                                </StackPanel>

                                <StackPanel
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="10,15,10,15">
                                    <TextBlock
                                        Margin="5,0,0,0"
                                        FontFamily="Verdana"
                                        FontSize="16"
                                        Foreground="#1e1e1e"
                                        Text="Confirm Password" />
                                    <PasswordBox
                                        x:Name="ConfirmPasswordBox"
                                        Width="200"
                                        Height="40"
                                        Padding="8"
                                        FontFamily="Verdana"
                                        FontSize="14" />
                                </StackPanel>

                                <StackPanel
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Margin="5,15,5,15"
                                    VerticalAlignment="Center">
                                    <Button
                                        Width="200"
                                        Height="50"
                                        Margin="0,10,5,10"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom"
                                        Background="#FF5D3754"
                                        Click="SaveUser_Click"
                                        Content="Save User"
                                        FontFamily="Verdana"
                                        FontSize="20"
                                        FontWeight="Bold" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>