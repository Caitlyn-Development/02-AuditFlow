<UserControl
    x:Class="_02_AuditFlowApplication.Views.ManagerUserView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:_02_AuditFlowApplication"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
    xmlns:views="clr-namespace:_02_AuditFlowApplication.Views"
    Background="#FFFFFF"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <views:ManagerLayout
            x:Name="Layout"
            Grid.Row="0"
            Grid.RowSpan="2" />

        <ScrollViewer
            Grid.Row="1"
            Height="944"
            Margin="251,120,0,0"
            Padding="30,20"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Width="1589">
                <!--  Dashboard Header  -->
                <TextBlock
                    Width="1121"
                    Margin="10,0,0,25"
                    HorizontalAlignment="Left"
                    FontFamily="Verdana"
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="#FF1E1E1E"
                    Text="User Managment" />

                <!--  Users Section  -->
                <Border
                    Width="1459"
                    Height="383"
                    Margin="0,0,0,25"
                    Padding="25"
                    Background="White"
                    BorderThickness="2,2,2,2"
                    CornerRadius="15">
                    <Border.BorderBrush>
                        <SolidColorBrush Opacity="0.2" Color="#FF1E1E1E" />
                    </Border.BorderBrush>
                    <StackPanel>

                        <!--  Users Header  -->
                        <Grid Margin="0,0,0,20">
                            <TextBlock
                                Margin="0,0,1141,0"
                                VerticalAlignment="Center"
                                FontFamily="Verdana"
                                FontSize="22"
                                FontWeight="SemiBold"
                                Foreground="#FF1E1E1E"
                                Text="User Accounts" />
                        </Grid>

                        <!--  Users Display Grid  -->
                        <DataGrid
                            x:Name="UsersGrid"
                            Height="284"
                            AutoGenerateColumns="False"
                            Background="White"
                            BorderThickness="0"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            GridLinesVisibility="None"
                            HeadersVisibility="Column"
                            IsReadOnly="True"
                            RowHeight="45"
                            SelectionMode="Single"
                            SelectionUnit="FullRow">

                            <!--  Header Style  -->
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="#1e1e1e" />
                                    <Setter Property="FontFamily" Value="Verdana" />
                                    <Setter Property="FontSize" Value="14" />
                                    <Setter Property="FontStyle" Value="Italic" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="Padding" Value="10,10,10,10" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                    <Setter Property="BorderBrush" Value="#E0E0E0" />
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <!--  Row Style  -->
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="White" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                    <Setter Property="BorderBrush" Value="#F0F0F0" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F9F9F9" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>

                            <!--  Cell Style  -->
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Padding" Value="10,10" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Foreground" Value="#1E1E1E" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>

                            <DataGrid.Columns>
                                <!--  Username  -->
                                <DataGridTextColumn
                                    Width="1.2*"
                                    Binding="{Binding Username}"
                                    Header="Username">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Padding" Value="10,10" />
                                            <Setter Property="FontFamily" Value="Verdana" />
                                            <Setter Property="FontSize" Value="14" />
                                            <Setter Property="Foreground" Value="#1E1E1E" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!--  Fullname  -->
                                <DataGridTextColumn
                                    Width="1.5*"
                                    Binding="{Binding FullName}"
                                    Header="Full Name">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Padding" Value="10,10" />
                                            <Setter Property="FontFamily" Value="Verdana" />
                                            <Setter Property="FontSize" Value="14" />
                                            <Setter Property="Foreground" Value="#1e1e1e" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!--  Role  -->
                                <DataGridTextColumn
                                    Width="1*"
                                    Binding="{Binding Role}"
                                    Header="Role">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Padding" Value="10,10" />
                                            <Setter Property="FontFamily" Value="Verdana" />
                                            <Setter Property="FontSize" Value="14" />
                                            <Setter Property="Foreground" Value="#1e1e1e" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!--  Status  -->
                                <DataGridTextColumn
                                    Width="1*"
                                    Binding="{Binding IsActive}"
                                    Header="Status">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Padding" Value="10,10" />
                                            <Setter Property="FontFamily" Value="Verdana" />
                                            <Setter Property="FontSize" Value="14" />
                                            <Setter Property="Foreground" Value="#1e1e1e" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!--  Actions  -->
                                <DataGridTemplateColumn Width="3*" Header="Actions">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <!--  Edit Button  -->
                                                <Button
                                                    Width="18"
                                                    Height="18"
                                                    Margin="15,0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Click="EditUser_Click"
                                                    Tag="{Binding UserID}">
                                                    <Button.ToolTip>
                                                        <ToolTip
                                                            Content="Edit User"
                                                            FontFamily="Verdana"
                                                            FontSize="12" />
                                                    </Button.ToolTip>
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <ContentPresenter />
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <svgc:SvgViewbox
                                                        Width="18"
                                                        Height="18"
                                                        Source="/Resources/Svg/pen-to-square-solid-full.svg" />
                                                </Button>

                                                <!--  Delete Button  -->
                                                <Button
                                                    Width="18"
                                                    Height="18"
                                                    Margin="15,0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Click="DeleteUser_Click"
                                                    Tag="{Binding UserID}">
                                                    <Button.ToolTip>
                                                        <ToolTip
                                                            Content="Delete User"
                                                            FontFamily="Verdana"
                                                            FontSize="12" />
                                                    </Button.ToolTip>
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <ContentPresenter />
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <svgc:SvgViewbox
                                                        Width="18"
                                                        Height="18"
                                                        Source="/Resources/Svg/circle-xmark-solid-full.svg" />
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!--  Create Audits Section  -->
                <Border
                    Width="1459"
                    Height="383"
                    Margin="0,0,0,25"
                    Padding="25"
                    Background="White"
                    BorderThickness="2,2,2,2"
                    CornerRadius="15">
                    <Border.BorderBrush>
                        <SolidColorBrush Opacity="0.2" Color="#FF1E1E1E" />
                    </Border.BorderBrush>
                    <StackPanel>
                        <!--  Audits Header  -->
                        <Grid Margin="0,0,0,20">
                            <TextBlock
                                Margin="0,0,1141,0"
                                VerticalAlignment="Bottom"
                                FontFamily="Verdana"
                                FontSize="22"
                                FontWeight="SemiBold"
                                Foreground="#FF1E1E1E"
                                Text="Create User Account" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,15,0,15"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                                <TextBlock
                                    Margin="5,0,0,0"
                                    FontFamily="Verdana"
                                    FontSize="16"
                                    Foreground="#1e1e1e"
                                    Text="Username" />
                                <TextBox
                                    x:Name="UsernameBox"
                                    Width="200"
                                    Height="40"
                                    Padding="8"
                                    FontFamily="Verdana"
                                    FontSize="14" />
                            </StackPanel>

                            <StackPanel
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="10,15,10,15"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <TextBlock
                                    Margin="5,0,0,0"
                                    FontFamily="Verdana"
                                    FontSize="16"
                                    Foreground="#1e1e1e"
                                    Text="Full Name" />
                                <TextBox
                                    x:Name="FullNameBox"
                                    Width="200"
                                    Height="40"
                                    Padding="8"
                                    FontFamily="Verdana"
                                    FontSize="14" />
                            </StackPanel>

                            <StackPanel
                                Grid.Row="0"
                                Grid.Column="2"
                                Margin="10,15,10,15"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                                <TextBlock
                                    Margin="5,0,0,0"
                                    FontFamily="Verdana"
                                    FontSize="16"
                                    Foreground="#1e1e1e"
                                    Text="Role" />
                                <ComboBox
                                    x:Name="RoleComboBox"
                                    Width="200"
                                    Height="40"
                                    Padding="8"
                                    FontFamily="Verdana"
                                    FontSize="14">
                                    <ComboBoxItem Content="Auditor" />
                                    <ComboBoxItem Content="Manager" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel
                                Grid.Row="1"
                                Grid.Column="0"
                                Margin="0,15,10,15"
                                HorizontalAlignment="Left">
                                <TextBlock
                                    Margin="5,0,0,0"
                                    FontFamily="Verdana"
                                    FontSize="16"
                                    Foreground="#1e1e1e"
                                    Text="Password" />
                                <PasswordBox
                                    x:Name="PasswordBox"
                                    Width="200"
                                    Height="40"
                                    Padding="8"
                                    FontFamily="Verdana"
                                    FontSize="14" />
                            </StackPanel>

                            <StackPanel
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="10,15,10,15">
                                <TextBlock
                                    Margin="5,0,0,0"
                                    FontFamily="Verdana"
                                    FontSize="16"
                                    Foreground="#1e1e1e"
                                    Text="Confirm Password" />
                                <PasswordBox
                                    x:Name="ConfirmPasswordBox"
                                    Width="200"
                                    Height="40"
                                    Padding="8"
                                    FontFamily="Verdana"
                                    FontSize="14" />
                            </StackPanel>

                            <StackPanel
                                Grid.Row="2"
                                Grid.Column="0"
                                Margin="5,15,5,15"
                                VerticalAlignment="Center">
                                <Button
                                    Width="200"
                                    Margin="0,10,5,10"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    Click="SaveUser_Click"
                                    Content="Save User"
                                    Style="{StaticResource DefaultManagerStyle}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>