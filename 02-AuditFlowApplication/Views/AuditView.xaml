<UserControl x:Class="_02_AuditFlowApplication.Views.AuditView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        xmlns:local="clr-namespace:_02_AuditFlowApplication"
        mc:Ignorable="d"
        Background="#FFFFFF">

    <UserControl.Resources>
        <!-- Button Style -->
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F0F0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Card Style -->
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.1" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section Header Style -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,20,0,15"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Navigation Bar -->
        <Border 
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1" Height="120" VerticalAlignment="Center">
            <Grid Margin="0,0,0,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo and Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Image x:Name="Logo" Source="/Resources/PNG/AuditFlow Logo.png" Width="206" Margin="250,0,0,0" Height="86"/>
                </StackPanel>

                <!-- Right Side Icons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Grid.ColumnSpan="2" Margin="1092,0,0,0">
                    <Button Width="50"
            Height="50"
            BorderThickness="0"
            Cursor="Hand"
            Background="Transparent"
            Margin="5,0">
                        <svgc:SvgViewbox Source="/Resources/Svg/gear-solid-full.svg"/>
                    </Button>
                    <Button Content="●" 
            FontSize="20"
            Width="50"
            Height="50"
            Background="Transparent"
            BorderThickness="0"
            Cursor="Hand"
            Margin="5,0" Foreground="Black"/>
                    <Button x:Name="LogoutButton"
            Width="50"
            Height="50"
            BorderThickness="0"
            Cursor="Hand"
            Background="Transparent"
            Margin="5,0">
                        <svgc:SvgViewbox Source="/Resources/Svg/arrow-right-from-bracket-solid-full.svg"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1" Height="944" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="251"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar Menu -->
            <Border Grid.Column="0" 
                    Background="White" 
                    BorderBrush="#E0E0E0"
                    BorderThickness="0,0,1,0"
                    Padding="15,20" Height="944" VerticalAlignment="Center">
                <StackPanel>
                    <Button Content="Dashboard" 
            Style="{StaticResource MenuButtonStyle}"
            Click="DashboardButton_Click"
            Background="#E3F2FD"
            Foreground="#2196F3"
            FontWeight="SemiBold" FontFamily="Verdana" FontSize="16"/>

                    <Button Content="Audits" 
            Style="{StaticResource MenuButtonStyle}" Click="AuditsButton_Click" Foreground="#FF1E1E1E" FontFamily="Verdana" FontSize="16"/>

                    <Button Content="Tasks" 
            Style="{StaticResource MenuButtonStyle}" Click="TasksButton_Click" Foreground="#FF1E1E1E" FontFamily="Verdana" FontSize="16"/>

                    <Separator Margin="0,15" Background="#E0E0E0"/>
                </StackPanel>
            </Border>

            <!-- Main Dashboard Content -->
            <ScrollViewer Grid.Column="1" 
                          VerticalScrollBarVisibility="Auto"
                          Padding="30,20" Height="944" VerticalAlignment="Center">
                <StackPanel Width="1589">
                    <!-- Dashboard Header -->
                    <TextBlock 
                               FontSize="22" 
                               Margin="10,0,0,25"
                               Foreground="#FF1E1E1E" FontFamily="Verdana" FontWeight="Bold" Width="1121" HorizontalAlignment="Left"><Run Text="Audit "/><Run Language="en-gb" Text="Scheduling"/></TextBlock>

                    <!-- Statistics Cards Row -->
                    <Grid Margin="0,0,0,40" Width="1452">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition  Width="Auto"/>
                            <ColumnDefinition  Width="Auto"/>
                            <ColumnDefinition  Width="Auto"/>
                            <ColumnDefinition  Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Total Audits Card -->
                        <Border Grid.Column="0" Style="{StaticResource StatCardStyle}" CornerRadius="15,15,15,15" BorderThickness="2,2,2,2" Padding="10,10,10,10" Height="80" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,30,0" Width="100">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="#FF1E1E1E" Opacity="0.2"/>
                            </Border.BorderBrush>
                            <StackPanel>
                                <svgc:SvgViewbox Source="/Resources/Svg/filter-solid-full.svg" Height="40" Width="40" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,10"/>
                                <StackPanel Orientation="Horizontal"/>
                            </StackPanel>
                        </Border>

                        <!-- Audits In Progress Card -->
                        <Border Style="{StaticResource StatCardStyle}" CornerRadius="15,15,15,15" BorderThickness="2,2,2,2" Padding="10,10,10,10" Margin="0,0,50,0" Height="80" VerticalAlignment="Center" Width="500" Grid.Column="1">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="#FF1E1E1E" Opacity="0.2"/>
                            </Border.BorderBrush>
                            <StackPanel>
                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="69"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <svgc:SvgViewbox Source="/Resources/Svg/magnifying-glass-solid-full.svg" Height="50" Width="50" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,3,0,10"/>
                                    </StackPanel>
                                    <TextBlock Text="Search Audits" Foreground="#1e1e1e" FontFamily="Verdana" FontSize="18" HorizontalAlignment="Left" Width="408" Grid.Column="1" Margin="15,21,0,21"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal"/>
                            </StackPanel>
                        </Border>

                        <!-- Completed Audits Card -->
                        <Border Grid.Column="2" Style="{StaticResource StatCardStyle}" CornerRadius="15,15,15,15" BorderThickness="2,2,2,2" Padding="10,10,10,10" Margin="0,0,50,0" Height="80" VerticalAlignment="Center" Width="227">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="#FF1E1E1E" Opacity="0.2"/>
                            </Border.BorderBrush>
                            <StackPanel>
                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="All Types" Foreground="#1e1e1e" FontFamily="Verdana" FontSize="18" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,15,0,15"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal"/>
                            </StackPanel>
                        </Border>

                        <!-- Overdue Audits Card -->
                        <Border Grid.Column="3" Style="{StaticResource StatCardStyle}" CornerRadius="15,15,15,15" BorderThickness="2,2,2,2" Padding="10,10,10,10" Margin="0,0,50,0" Height="80" VerticalAlignment="Center" Width="227">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="#FF1E1E1E" Opacity="0.2"/>
                            </Border.BorderBrush>
                            <StackPanel>
                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="All Status" FontSize="18" FontFamily="Verdana" Foreground="#1e1e1e" Margin="0,15,0,15"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Calendar Section -->
                    <Border Background="White" 
                            CornerRadius="10" 
                            Padding="25"
                            Margin="0,0,0,25" BorderThickness="2,2,2,2" Width="1459" Height="383">
                        <Border.BorderBrush>
                            <SolidColorBrush Color="#FF1E1E1E" Opacity="0.2"/>
                        </Border.BorderBrush>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.1" Color="#000000"/>
                        </Border.Effect>

                        <StackPanel>
                            <!-- Calendar Header -->
                            <Grid Margin="0,0,0,20">
                                <TextBlock 
                                           FontSize="22" 
                                           FontWeight="SemiBold"
                                           Foreground="#FF1E1E1E"
                                           VerticalAlignment="Center" FontFamily="Verdana" Margin="0,0,1141,0"><Run Text="Scheduled "/><Run Language="en-gb" Text="Audits"/></TextBlock>

                                <StackPanel Orientation="Horizontal" 
                                            HorizontalAlignment="Left" Margin="537,0,0,0" Width="868"/>
                            </Grid>

                            <!-- Calendar Grid -->
                            <Grid Height="284">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="67"/>
                                    <ColumnDefinition Width="Auto" MinWidth="33"/>
                                    <ColumnDefinition Width="Auto" MinWidth="50"/>
                                    <ColumnDefinition Width="Auto" MinWidth="101"/>
                                    <ColumnDefinition Width="Auto" MinWidth="49"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" MinHeight="40"/>
                                    <RowDefinition Height="Auto" MinHeight="40"/>
                                    <RowDefinition Height="Auto" MinHeight="40"/>
                                    <RowDefinition Height="Auto" MinHeight="40"/>
                                    <RowDefinition Height="Auto" MinHeight="40"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Column="0" Grid.Row="0" Text="Audit Name" FontFamily="Verdana" FontSize="16" Width="281" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" Grid.Row="0" Text="Type" FontFamily="Verdana" FontSize="16" Width="100" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="2" Grid.Row="0" Text="Start Date" FontFamily="Verdana" FontSize="16" Width="171" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="3" Grid.Row="0" Text="Due Date" FontFamily="Verdana" FontSize="16" Width="171" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="4" Grid.Row="0" Text="Recurring" FontFamily="Verdana" FontSize="16" Width="171" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="5" Grid.Row="0" Text="Status" FontFamily="Verdana" FontSize="16" Width="171" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,10,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
