<UserControl x:Class="_02_AuditFlowApplication.Views.AuditView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        xmlns:local="clr-namespace:_02_AuditFlowApplication"
        mc:Ignorable="d"
        Background="#FFFFFF">

    <UserControl.Resources>

        <!-- Button Style -->
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F0F0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Card Style -->
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.1" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section Header Style -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,20,0,15"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>

        <!-- Combo Box Style -->
        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="#1e1e1e"
                                            BorderThickness="2"
                                            Focusable="False"
                                            IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                            ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid Background="{TemplateBinding Background}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Selected Item Display -->
                                            <ContentPresenter Grid.Column="0"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Center"
                                                                Margin="20,0,0,0"
                                                                Content="{TemplateBinding Content}"
                                                                ContentTemplate="{TemplateBinding ContentTemplate}"/>

                                            <!-- Dropdown Arrow -->
                                            <Path Grid.Column="1"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="#1E1E1E"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,20,0"
                                                      Width="12"
                                                      Height="8"
                                                      Stretch="Uniform"/>
                                        </Grid>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- Dropdown Popup -->
                            <Popup x:Name="Popup"
                                       Placement="Bottom"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="Slide">
                                <Border Background="White"
                                            BorderBrush="#E0E0E0"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Margin="0,4,0,0"
                                            MinWidth="{TemplateBinding ActualWidth}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2" Color="#000000"/>
                                    </Border.Effect>
                                    <ScrollViewer Margin="0,4">
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Combo Box Item Style -->
        <Style x:Key="ComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="FontFamily" Value="Verdana"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#1E1E1E"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                    BorderThickness="0"
                                    Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F5F5F5"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#E3F2FD"/>
                                <Setter Property="Foreground" Value="#2196F3"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Navigation Bar -->
        <Border 
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1" Height="120" VerticalAlignment="Center">
            <Grid Margin="0,0,0,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo and Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Image x:Name="Logo" Source="/Resources/PNG/AuditFlow Logo.png" Width="206" Margin="250,0,0,0" Height="86"/>
                </StackPanel>

                <!-- Right Side Icons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Grid.ColumnSpan="2" Margin="1092,0,0,0">
                    <Button Width="50"
            Height="50"
            BorderThickness="0"
            Cursor="Hand"
            Background="Transparent"
            Margin="5,0">
                        <svgc:SvgViewbox Source="/Resources/Svg/gear-solid-full.svg"/>
                    </Button>
                    <Button Content="●" 
            FontSize="20"
            Width="50"
            Height="50"
            Background="Transparent"
            BorderThickness="0"
            Cursor="Hand"
            Margin="5,0" Foreground="Black"/>
                    <Button x:Name="LogoutButton"
            Width="50"
            Height="50"
            BorderThickness="0"
            Cursor="Hand"
            Background="Transparent"
            Margin="5,0">
                        <svgc:SvgViewbox Source="/Resources/Svg/arrow-right-from-bracket-solid-full.svg"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1" Height="944" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="251"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar Menu -->
            <Border Grid.Column="0" 
                    Background="White" 
                    BorderBrush="#E0E0E0"
                    BorderThickness="0,0,1,0"
                    Padding="15,20" Height="944" VerticalAlignment="Center">
                <StackPanel>
                    <Button Content="Dashboard" 
            Style="{StaticResource MenuButtonStyle}"
            Click="DashboardButton_Click"
            Background="#E3F2FD"
            Foreground="#2196F3"
            FontWeight="SemiBold" FontFamily="Verdana" FontSize="16"/>

                    <Button Content="Audits" 
            Style="{StaticResource MenuButtonStyle}" Click="AuditsButton_Click" Foreground="#FF1E1E1E" FontFamily="Verdana" FontSize="16"/>

                    <Button Content="Tasks" 
            Style="{StaticResource MenuButtonStyle}" Click="TasksButton_Click" Foreground="#FF1E1E1E" FontFamily="Verdana" FontSize="16"/>

                    <Separator Margin="0,15" Background="#E0E0E0"/>
                </StackPanel>
            </Border>

            <!-- Main Dashboard Content -->
            <ScrollViewer x:Name="AuditsViewer" Grid.Column="1" 
                          VerticalScrollBarVisibility="Auto"
                          Padding="30,20" Height="944" VerticalAlignment="Center">
                <StackPanel Width="1589">
                    <!-- Dashboard Header -->
                    <TextBlock 
                              FontSize="22" 
                               Margin="10,0,0,25"
                               Foreground="#FF1E1E1E" 
                        FontFamily="Verdana" FontWeight="Bold" Width="1121" HorizontalAlignment="Left" Text="Audit Scheduling"/>

                    <!-- Statistics Cards Row -->
                    <Grid Margin="0,0,0,40" Width="1452">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition  Width="Auto"/>
                            <ColumnDefinition  Width="Auto"/>
                            <ColumnDefinition  Width="Auto"/>
                            <ColumnDefinition  Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Filter Button -->
                        <Border Grid.Column="0" Style="{StaticResource StatCardStyle}" CornerRadius="15,15,15,15" BorderThickness="2,2,2,2" Padding="10,10,10,10" Height="80" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,30,0" Width="100">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="#FF1E1E1E" Opacity="0.2"/>
                            </Border.BorderBrush>
                            <StackPanel>
                                <svgc:SvgViewbox Source="/Resources/Svg/filter-solid-full.svg" Height="40" Width="40" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,10"/>
                                <StackPanel Orientation="Horizontal"/>
                            </StackPanel>
                        </Border>

                        <!-- Search Audits -->
                        <Border CornerRadius="15" 
        BorderThickness="2" 
        Padding="15,0,15,0" 
        Margin="0,0,50,0" 
        Height="80" 
        VerticalAlignment="Center" 
        Width="500" 
        Grid.Column="1"
        Background="White">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.1" Color="#000000"/>
                            </Border.Effect>
                            <Border.BorderBrush>
                                <SolidColorBrush Color="#FF1E1E1E" Opacity="0.2"/>
                            </Border.BorderBrush>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Search Icon -->
                                <svgc:SvgViewbox Grid.Column="0"
                        Source="/Resources/Svg/magnifying-glass-solid-full.svg" 
                        Height="30" 
                        Width="30" 
                        VerticalAlignment="Center" 
                        Margin="0,0,15,0"/>

                                <!-- Search TextBox -->
                                <TextBox x:Name="SearchTextBox"
                 Grid.Column="1"
                 FontFamily="Verdana" 
                 FontSize="18" 
                 Foreground="#1E1E1E"
                 Background="Transparent"
                 BorderThickness="0"
                 VerticalAlignment="Center"
                 TextChanged="SearchTextBox_TextChanged"
                 GotFocus="SearchTextBox_GotFocus"
                 LostFocus="SearchTextBox_LostFocus">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="TextBox">
                                                        <Grid>
                                                            <!-- Placeholder Text -->
                                                            <TextBlock x:Name="PlaceholderText"
                                             Text="Search Audits"
                                             FontFamily="Verdana"
                                             FontSize="18"
                                             Foreground="#999999"
                                             VerticalAlignment="Center"
                                             IsHitTestVisible="False">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>

                                                            <!-- Actual TextBox -->
                                                            <ScrollViewer x:Name="PART_ContentHost" 
                                                VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>

                                <!-- Search Suggestions Popup -->
                                <Popup x:Name="SearchPopup"
               Grid.Column="1"
               PlacementTarget="{Binding ElementName=SearchTextBox}"
               Placement="Bottom"
               IsOpen="False"
               AllowsTransparency="True"
               StaysOpen="False"
               Width="470">
                                    <Border Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,4,0,0"
                    MaxHeight="300">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2" Color="#000000"/>
                                        </Border.Effect>
                                        <ListBox x:Name="SearchResultsListBox"
                         Background="Transparent"
                         BorderThickness="0"
                         SelectionChanged="SearchResultsListBox_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="15,12"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border Background="{TemplateBinding Background}"
                                                BorderThickness="0"
                                                Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#F5F5F5"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter Property="Background" Value="#E3F2FD"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding AuditName}"
                                         FontFamily="Verdana"
                                         FontSize="16"
                                         FontWeight="SemiBold"
                                         Foreground="#1E1E1E"/>
                                                        <TextBlock FontFamily="Verdana"
                                         FontSize="12"
                                         Foreground="#666666"
                                         Margin="0,4,0,0">
                                    <Run Text="{Binding Type}"/>
                                    <Run Text=" • "/>
                                    <Run Text="{Binding StatusDisplay}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <!--<Border Style="{StaticResource StatCardStyle}" CornerRadius="15,15,15,15" BorderThickness="2,2,2,2" Padding="10,10,10,10" Margin="0,0,50,0" Height="80" VerticalAlignment="Center" Width="500" Grid.Column="1">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="#FF1E1E1E" Opacity="0.2"/>
                            </Border.BorderBrush>
                            <StackPanel>
                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="69"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <svgc:SvgViewbox Source="/Resources/Svg/magnifying-glass-solid-full.svg" Height="50" Width="50" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,3,0,10"/>
                                    </StackPanel>
                                    <TextBlock Text="Search Audits" Foreground="#1e1e1e" FontFamily="Verdana" FontSize="18" HorizontalAlignment="Left" Width="408" Grid.Column="1" Margin="15,21,0,21"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal"/>
                            </StackPanel>
                        </Border>-->

                        <!-- Audit Types Filter -->
                        <Border Grid.Column="2" 
                                Style="{StaticResource StatCardStyle}" 
                                CornerRadius="15" 
                                BorderThickness="2" 
                                Padding="10" 
                                Margin="0,0,50,0" 
                                Height="80" 
                                VerticalAlignment="Center" 
                                Width="227">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="#FF1E1E1E" Opacity="0.2"/>
                            </Border.BorderBrush>
                            <ComboBox x:Name="TypeFilterBox"
                                      FontSize="16"
                                      FontFamily="Verdana"
                                      Foreground="#1e1e1e"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      VerticalAlignment="Center"
                                      SelectionChanged="TypeFilterBox_Changed">
                                <ComboBox.Items>
                                    <ComboBoxItem Content="All Types" IsSelected="True"/>
                                    <ComboBoxItem Content="Security"/>
                                    <ComboBoxItem Content="Safety"/>
                                    <ComboBoxItem Content="Quality"/>
                                    <ComboBoxItem Content="Data Protection"/>
                                    <ComboBoxItem Content="Financial"/>
                                </ComboBox.Items>
                            </ComboBox>
                        </Border>

                        <!-- Status Filter -->
                        <!--<Border Grid.Column="3" 
                                Style="{StaticResource StatCardStyle}" 
                                CornerRadius="15" 
                                BorderThickness="2" 
                                Padding="0" 
                                Margin="0,0,50,0" 
                                Height="80" 
                                VerticalAlignment="Center" 
                                Width="227"
                                Background="White">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="#FF1E1E1E" Opacity="0.2"/>
                            </Border.BorderBrush>-->
                            <ComboBox x:Name="StatusFilterBox"
                                      Grid.Column="3"
                                      Style="{StaticResource ComboBoxStyle}"
                                      FontSize="18"
                                      FontFamily="Verdana"
                                      Foreground="#1e1e1e"
                                      Background="White"
                                      Padding="20"
                                      BorderThickness="2"
                                      VerticalAlignment="Center"
                                      SelectionChanged="StatusFilterBox_Changed" Height="80" HorizontalAlignment="Left" Width="225">
                                <ComboBox.Resources>
                                    <Style TargetType="Path" x:Key="ArrowStyle">
                                        <Setter Property="Fill" Value="#1e1e1e"/>
                                    </Style>
                                </ComboBox.Resources>
                                <ComboBox.BorderBrush>
                                    <SolidColorBrush Color="#FF1E1E1E" Opacity="0.2"/>
                                </ComboBox.BorderBrush>
                                <ComboBox.Items>
                                    <ComboBoxItem Style="{StaticResource ComboBoxItemStyle}" Content="All Status" IsSelected="True"/>
                                    <ComboBoxItem Style="{StaticResource ComboBoxItemStyle}" Content="Not Started"/>
                                    <ComboBoxItem Style="{StaticResource ComboBoxItemStyle}" Content="In Progress"/>
                                    <ComboBoxItem Style="{StaticResource ComboBoxItemStyle}" Content="Completed"/>
                                    <ComboBoxItem Style="{StaticResource ComboBoxItemStyle}" Content="Overdue"/>
                                </ComboBox.Items>
                            </ComboBox>
                        <!--</Border>-->
                    </Grid>

                    <!-- Audits Section -->
                    <Border Background="White" 
                            CornerRadius="15" 
                            Padding="25"
                            Margin="0,0,0,25" 
                            BorderThickness="2,2,2,2" 
                            Width="1459" 
                            Height="383">
                        <Border.BorderBrush>
                            <SolidColorBrush Color="#FF1E1E1E" Opacity="0.2"/>
                        </Border.BorderBrush>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.1" Color="#000000"/>
                        </Border.Effect>
                        <StackPanel>

                            <!-- Audits Header -->
                            <Grid Margin="0,0,0,20">
                                <TextBlock 
                                    FontSize="22" 
                                    FontWeight="SemiBold"
                                    Foreground="#FF1E1E1E"
                                    VerticalAlignment="Center" 
                                    FontFamily="Verdana" 
                                    Margin="0,0,1141,0" 
                                    Text="Scheduled Audits"/>
                            </Grid>

                            <!-- Audit Display Grid -->
                            <DataGrid x:Name="AuditsGrid" 
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      Height="284" 
                                      RowHeight="45"
                                      GridLinesVisibility="None"
                                      BorderThickness="0"
                                      Background="White"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      AutoGenerateColumns="False"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow">

                                <!-- Header Style -->
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#1e1e1e"/>
                                        <Setter Property="FontFamily" Value="Verdana"/>
                                        <Setter Property="FontSize" Value="14"/>
                                        <Setter Property="FontStyle" Value="Italic"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Padding" Value="10,10,10,10"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>

                                <!-- Row Style -->
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush" Value="#F0F0F0"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F9F9F9"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>

                                <!-- Cell Style -->
                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="10,10"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Foreground" Value="#1E1E1E"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.CellStyle>

                                <DataGrid.Columns>
                                    <!-- Audit Name -->
                                    <DataGridTextColumn Header="Audit Name" 
                                                        Binding="{Binding AuditName}" 
                                                        Width="2.5*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Padding" Value="10,10"/>
                                                <Setter Property="FontFamily" Value="Verdana"/>
                                                <Setter Property="FontSize" Value="14"/>
                                                <Setter Property="Foreground" Value="#1E1E1E"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- Audit Type -->
                                    <DataGridTextColumn Header="Type" 
                                                        Binding="{Binding Type}" 
                                                        Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Padding" Value="10,10"/>
                                                <Setter Property="FontFamily" Value="Verdana"/>
                                                <Setter Property="FontSize" Value="14"/>
                                                <Setter Property="Foreground" Value="#1e1e1e"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- Start Date -->
                                    <DataGridTextColumn Header="Start Date" 
                                                        Binding="{Binding StartDate, StringFormat=dd-MM-yyyy}" 
                                                        Width="1.5*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Padding" Value="10,10"/>
                                                <Setter Property="FontFamily" Value="Verdana"/>
                                                <Setter Property="FontSize" Value="14"/>
                                                <Setter Property="Foreground" Value="#1e1e1e"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- Due Date -->
                                    <DataGridTextColumn Header="Due Date" 
                                                        Binding="{Binding EndDate, StringFormat=dd-MM-yyyy}" 
                                                        Width="1.5*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Padding" Value="10,10"/>
                                                <Setter Property="FontFamily" Value="Verdana"/>
                                                <Setter Property="FontSize" Value="14"/>
                                                <Setter Property="Foreground" Value="#1e1e1e"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- Recurring -->
                                    <DataGridTextColumn Header="Recurring" 
                                                        Binding="{Binding RecurrenceType}" 
                                                        Width="1.2*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Padding" Value="10,10"/>
                                                <Setter Property="FontFamily" Value="Verdana"/>
                                                <Setter Property="FontSize" Value="14"/>
                                                <Setter Property="Foreground" Value="#1e1e1e"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- Status with Template for Badge -->
                                    <DataGridTemplateColumn Header="Status" Width="1.2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="20"
                                                        Height="30"
                                                        Width="120"
                                                        Padding="5,5"
                                                        HorizontalAlignment="Left">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="NotStarted">
                                                                    <Setter Property="Background" Value="#424242"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="InProgress">
                                                                    <Setter Property="Background" Value="#0070A8"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                    <Setter Property="Background" Value="#008015"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Overdue">
                                                                    <Setter Property="Background" Value="#BD0000"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Status}"
                                                               FontFamily="Verdana"
                                                               FontSize="12"
                                                               FontWeight="Bold"
                                                               Foreground="White"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>