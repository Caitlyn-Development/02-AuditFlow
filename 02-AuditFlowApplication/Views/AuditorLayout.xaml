<UserControl
    x:Class="_02_AuditFlowApplication.Views.AuditorLayout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:_02_AuditFlowApplication.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:svgc="http://sharpvectors.codeplex.com/svgc/">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Top Navigation Bar  -->
        <Border
            Grid.Row="0"
            Height="120"
            VerticalAlignment="Center"
            Background="White"
            BorderBrush="#E0E0E0"
            BorderThickness="0,0,0,1">
            <Grid Margin="0,0,0,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Image
                        Width="206"
                        Height="86"
                        Margin="250,0,0,0"
                        AutomationProperties.Name="AuditFlow logo"
                        Source="/Resources/PNG/AuditFlow Logo.png" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Margin="1092,0,0,0"
                    Orientation="Horizontal">
                    <Button
                        AutomationProperties.Name="Settings"
                        Cursor="Hand"
                        Style="{StaticResource DefaultIconStyle}">
                        <svgc:SvgViewbox Source="/Resources/Svg/gear-solid-full.svg" />
                    </Button>
                    <Button
                        x:Name="LogoutButton"
                        AutomationProperties.HelpText="Click to log out"
                        AutomationProperties.Name="Logout"
                        Cursor="Hand"
                        Style="{StaticResource DefaultIconStyle}">
                        <svgc:SvgViewbox Source="/Resources/Svg/arrow-right-from-bracket-solid-full.svg" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  Main Area  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="251" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Sidebar  -->
            <Border
                Grid.Column="0"
                Height="944"
                Padding="15,20"
                VerticalAlignment="Top"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,1,0">
                <StackPanel>
                    <Button
                        x:Name="DashboardButton"
                        AutomationProperties.HelpText="Navigate to dashboard"
                        AutomationProperties.Name="Dashboard"
                        Content="Dashboard"
                        FontFamily="Verdana"
                        FontSize="16"
                        Style="{StaticResource MenuButtonStyle}" />
                    <Button
                        x:Name="AuditsButton"
                        AutomationProperties.HelpText="Navigate to audits"
                        AutomationProperties.Name="Audits"
                        Content="Audits"
                        FontFamily="Verdana"
                        FontSize="16"
                        Style="{StaticResource MenuButtonStyle}" />
                    <Button
                        x:Name="TasksButton"
                        AutomationProperties.HelpText="Navigate to tasks"
                        AutomationProperties.Name="Tasks"
                        Content="Tasks"
                        FontFamily="Verdana"
                        FontSize="16"
                        Style="{StaticResource MenuButtonStyle}" />
                    <Separator Margin="0,15" Background="#E0E0E0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
